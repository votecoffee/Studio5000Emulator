          <LocalTag Name="LocalList" DataType="CONTROL" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(CompareEnable)FBC(Source[SourceIndex],Reference[ReferenceIndex],CompareResults[ResultIndex],CompareState,?,?,CompareListState,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(DetectEnable)DDT(Source[SourceIndex],Learned[ReferenceIndex],DetectResults[ResultIndex],DetectState,?,?,DetectListState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(DetectEnable)DDT(Source[SourceIndex],Scratch[ReferenceIndex],LocalResults[ResultIndex],LocalCompare,?,?,LocalList,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(CompareState.FD)OTE(CompareFound);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(DetectState.FD)OTE(DetectFound);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()FBC(Source[SourceIndex],Reference[ReferenceIndex],CompareResults[ResultIndex],CompareState,?,?,CompareListState,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()DDT(Source[SourceIndex],Learned[ReferenceIndex],DetectResults[ResultIndex],DetectState,?,?,DetectListState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()DDT(Source[SourceIndex],Scratch[ReferenceIndex],LocalResults[ResultIndex],LocalCompare,?,?,LocalList,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>AFI()OTE(CompareFound);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>AFI()OTE(DetectFound);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
