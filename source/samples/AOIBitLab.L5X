      <AddOnInstructionDefinition Name="LabBitDiagnostics" Class="Standard" Revision="1.0" Vendor="LogixLab" SoftwareRevision="v35.01" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true">
        <Parameters>
          <Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="CompareEnable" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="DetectEnable" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
