              <Rung Number="0" Type="N">
                <Text>XIC(EnabledA)LabBitDiagnostics(DriverA,CompareEnable,DetectEnable,SourceIndexA,ReferenceIndexA,ResultIndexA,SourceView,ReferenceA,LearnedA,CompareResultsA,DetectResultsA,CompareA,CompareListA,DetectA,DetectListA);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(EnabledB)LabBitDiagnostics(DriverB,CompareEnable,DetectEnable,SourceIndexB,ReferenceIndexB,ResultIndexB,SourceB,ReferenceB,LearnedB,CompareResultsB,DetectResultsB,CompareB,CompareListB,DetectB,DetectListB);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>DIV(1,FaultDivisor,Quotient);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
