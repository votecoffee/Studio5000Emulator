          <Parameter Name="CompareResults" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="DetectResults" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="CompareState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="CompareListState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="DetectState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="DetectListState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="CompareFound" DataType="BOOL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="DetectFound" DataType="BOOL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Scratch" DataType="DINT" Dimensions="4" />
          <LocalTag Name="LocalResults" DataType="DINT" Dimensions="6" />
