<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="AOIConstantsLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="AOIConstantsLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <Description>Synthetic exact numeric AOI inputs, copied parameters and false-call output retention.</Description>
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabTypedInputs" Class="Standard" Revision="1.0" Vendor="LogixLab" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Required="false" Visible="false" />
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="false" />
          <Parameter Name="Signed" TagType="Base" DataType="LINT" Usage="Input" Required="true" Visible="true" />
          <Parameter Name="Unsigned" TagType="Base" DataType="UDINT" Usage="Input" Required="true" Visible="true" />
          <Parameter Name="Largest" TagType="Base" DataType="ULINT" Usage="Input" Required="true" Visible="true" />
          <Parameter Name="Precise" TagType="Base" DataType="LREAL" Usage="Input" Required="true" Visible="true" />
          <Parameter Name="SignedOut" TagType="Base" DataType="LINT" Usage="Output" Required="true" Visible="true" />
          <Parameter Name="UnsignedOut" TagType="Base" DataType="UDINT" Usage="Output" Required="true" Visible="true" />
          <Parameter Name="LargestOut" TagType="Base" DataType="ULINT" Usage="Output" Required="true" Visible="true" />
          <Parameter Name="PreciseOut" TagType="Base" DataType="LREAL" Usage="Output" Required="true" Visible="true" />
        </Parameters>
        <LocalTags />
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>MOV(Signed,SignedOut)MOV(Unsigned,UnsignedOut)MOV(Largest,LargestOut)MOV(Precise,PreciseOut);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Tags>
      <Tag Name="Enabled" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SignedResult" DataType="LINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="LINT" Value="0" /></Data></Tag>
      <Tag Name="UnsignedResult" DataType="UDINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="UDINT" Value="0" /></Data></Tag>
      <Tag Name="LargestResult" DataType="ULINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="ULINT" Value="0" /></Data></Tag>
      <Tag Name="PreciseResult" DataType="LREAL" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="LREAL" Value="0.0" /></Data></Tag>
      <Tag Name="TypedInputs" DataType="LabTypedInputs" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="LabTypedInputs">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Signed" DataType="LINT" Value="0" />
            <DataValueMember Name="Unsigned" DataType="UDINT" Value="0" />
            <DataValueMember Name="Largest" DataType="ULINT" Value="0" />
            <DataValueMember Name="Precise" DataType="LREAL" Value="0.0" />
            <DataValueMember Name="SignedOut" DataType="LINT" Value="0" />
            <DataValueMember Name="UnsignedOut" DataType="UDINT" Value="0" />
            <DataValueMember Name="LargestOut" DataType="ULINT" Value="0" />
            <DataValueMember Name="PreciseOut" DataType="LREAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(Enabled)LabTypedInputs(TypedInputs,9007199254740993L,4294967295U,18446744073709551615UL,1.0000000000000002L,SignedResult,UnsignedResult,LargestResult,PreciseResult);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms><ScheduledProgram Name="MainProgram" /></ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
