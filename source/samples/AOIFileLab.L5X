<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="AOIFileLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="AOIFileLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabFileDriver" Class="Standard" Revision="1.0" Vendor="LogixLab" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" SoftwareRevision="v35.01">
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="Transform" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Search" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Gain" TagType="Base" DataType="DINT" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Bias" TagType="Base" DataType="DINT" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Threshold" TagType="Base" DataType="DINT" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Input" TagType="Base" DataType="DINT" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Dimensions="5" Constant="false" />
          <Parameter Name="Output" TagType="Base" DataType="DINT" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Dimensions="5" Constant="false" />
          <Parameter Name="Calc" TagType="Base" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false" />
          <Parameter Name="Find" TagType="Base" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false" />
          <Parameter Name="Found" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="Position" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="Total" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Scratch" DataType="DINT" Dimensions="5" ExternalAccess="None" />
          <LocalTag Name="LocalCalc" DataType="CONTROL" ExternalAccess="None" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Reset)RES(Calc)RES(Find)RES(LocalCalc)CLR(Total);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Transform)FAL(Calc,?,?,INC,Output[Calc.POS],Input[Calc.POS]*Gain+Bias);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Search)FSC(Find,?,?,INC,Input[Find.POS]&gt;=Threshold);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Transform)FAL(LocalCalc,?,?,INC,Scratch[LocalCalc.POS],Input[LocalCalc.POS]+Bias);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>MOV(Find.POS,Position)XIC(Find.FD)OTE(Found);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>CPT(Total,Scratch[0]+Scratch[1]+Scratch[2]+Scratch[3]);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()FAL(Calc,?,?,INC,Output[Calc.POS],Input[Calc.POS]*Gain+Bias);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()FSC(Find,?,?,INC,Input[Find.POS]&gt;=Threshold);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()FAL(LocalCalc,?,?,INC,Scratch[LocalCalc.POS],Input[LocalCalc.POS]+Bias);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Tags>
