    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(Steps,1,Steps);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(EnabledA)LabFileDriver(DriverA,Transform,Search,Reset,GainA,BiasA,LimitA,InputA,OutputA,CalcA,FindA);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(EnabledB)LabFileDriver(DriverB,Transform,Search,Reset,GainB,BiasB,LimitB,InputB,OutputB,CalcB,FindB);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
