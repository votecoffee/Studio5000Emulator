    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(EnableA)LabAccumulator(AccumulatorA,StepA,TotalA,SharedA)OTE(AReady);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(EnableB)LabAccumulator(AccumulatorB,StepB,TotalB,SharedB)OTE(BReady);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>LabWrapper(NestedScale,RawValue,ScaledValue);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>TRN(ScaledValue,Truncated);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
