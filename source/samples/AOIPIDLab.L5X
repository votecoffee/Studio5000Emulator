        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>PID(State,PV,Tieback,CV,0,Inhold,Readback);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>PID(Local,PV,Tieback,AuxValue,0,Inhold,Readback);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()PID(State,PV,Tieback,CV,0,Inhold,Readback);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()PID(Local,PV,Tieback,AuxValue,0,Inhold,Readback);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
