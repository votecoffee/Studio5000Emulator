<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="AOIQueueLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="AOIQueueLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabQueueDriver" Class="Standard" Revision="1.0" Vendor="LogixLab" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" SoftwareRevision="v35.01">
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="Load" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Unload" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Push" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Pop" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Shift" TagType="Base" DataType="BOOL" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Index" TagType="Base" DataType="DINT" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Value" TagType="Base" DataType="DINT" Usage="Input" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Item" TagType="Base" DataType="DINT" Usage="Output" Required="true" Visible="true" ExternalAccess="Read/Write" />
          <Parameter Name="Buffer" TagType="Base" DataType="DINT" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Dimensions="6" Constant="false" />
          <Parameter Name="State" TagType="Base" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false" />
          <Parameter Name="Popped" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
          <Parameter Name="Word" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="false" ExternalAccess="Read/Write" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Stack" DataType="DINT" Dimensions="4" ExternalAccess="None" />
          <LocalTag Name="StackState" DataType="CONTROL" Dimensions="0" ExternalAccess="None" />
          <LocalTag Name="Bits" DataType="DINT" Dimensions="3" ExternalAccess="None" />
          <LocalTag Name="ShiftState" DataType="CONTROL" Dimensions="0" ExternalAccess="None" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Load)FFL(Value,Buffer[Index],State,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Unload)FFU(Buffer[Index],Item,State,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Push)LFL(Value,Stack[0],StackState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Pop)LFU(Stack[0],Popped,StackState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Shift)BSL(Bits[0],ShiftState,EnableIn,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>MOV(Bits[0],Word);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()FFL(Value,Buffer[Index],State,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()FFU(Buffer[Index],Item,State,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()LFL(Value,Stack[0],StackState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>AFI()LFU(Stack[0],Popped,StackState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>AFI()BSL(Bits[0],ShiftState,EnableIn,?);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
