    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(Steps,1,Steps);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(EnabledA)LabQueueDriver(DriverA,Load,Unload,Push,Pop,Shift,IndexA,ValueA,ItemA,BufferA,StateA);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(EnabledB)LabQueueDriver(DriverB,Load,Unload,Push,Pop,Shift,IndexB,ValueB,ItemB,BufferB,StateB);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
