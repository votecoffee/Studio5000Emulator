  <Controller Name="AOISequencerLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabSequencer" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true">
        <Parameters>
          <Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="Step" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Teach" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Index" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Value" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Feedback" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Table" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="Learned" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="Sequence" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="TeachState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Destination" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Matched" DataType="BOOL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="LocalValue" DataType="DINT" Usage="Output" Required="false" Visible="true" Dimensions="0" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Scratch" DataType="DINT" Dimensions="6" />
          <LocalTag Name="LocalState" DataType="CONTROL" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Step)SQO(Table[Index],16#FF,Destination,Sequence,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Step)SQI(Table[Index],16#FF,Feedback,Sequence,?,?)OTE(Matched);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Teach)SQL(Learned[Index],Value,TeachState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Teach)SQL(Scratch[Index],Value,LocalState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>MOV(Scratch[2],LocalValue);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()SQO(Table[Index],16#FF,Destination,Sequence,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()SQI(Table[Index],16#FF,Feedback,Sequence,?,?)OTE(Matched);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()SQL(Learned[Index],Value,TeachState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>AFI()SQL(Scratch[Index],Value,LocalState,?,?);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
