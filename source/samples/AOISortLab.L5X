  <Controller Name="AOISortLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabSortDriver" Class="Standard" Revision="1.0" Vendor="LogixLab" SoftwareRevision="v35.01" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true">
        <Parameters>
          <Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="Sort" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Index" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Column" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Row" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Samples" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="Grid" DataType="REAL" Usage="InOut" Required="true" Visible="true" Dimensions="2,3" />
          <Parameter Name="Cube" DataType="INT" Usage="InOut" Required="true" Visible="true" Dimensions="2,2,3" />
          <Parameter Name="State" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="GridState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="CubeState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Ready" DataType="BOOL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Scratch" DataType="DINT" Dimensions="6" />
          <LocalTag Name="LocalState" DataType="CONTROL" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Sort)SRT(Samples[Index],0,State,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Sort)SRT(Grid[0,Column],0,GridState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Sort)SRT(Cube[1,Row,0],2,CubeState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Sort)SRT(Scratch[Index],0,LocalState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(State.DN)XIC(GridState.DN)XIC(CubeState.DN)XIC(LocalState.DN)OTE(Ready);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()SRT(Samples[Index],0,State,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()SRT(Grid[0,Column],0,GridState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()SRT(Cube[1,Row,0],2,CubeState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>AFI()SRT(Scratch[Index],0,LocalState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>AFI()OTE(Ready);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
