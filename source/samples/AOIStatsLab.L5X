    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="LabStatsDriver" Class="Standard" Revision="1.0" Vendor="LogixLab" SoftwareRevision="v35.01" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true">
        <Parameters>
          <Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Required="false" Visible="false" Dimensions="0" />
          <Parameter Name="Calculate" DataType="BOOL" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Index" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Row" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Column" DataType="DINT" Usage="Input" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Samples" DataType="REAL" Usage="InOut" Required="true" Visible="true" Dimensions="6" />
          <Parameter Name="Grid" DataType="DINT" Usage="InOut" Required="true" Visible="true" Dimensions="2,3" />
          <Parameter Name="Cube" DataType="INT" Usage="InOut" Required="true" Visible="true" Dimensions="2,2,3" />
          <Parameter Name="MeanState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="DeviationState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="ColumnState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="RowState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="PlaneState" DataType="CONTROL" Usage="InOut" Required="true" Visible="true" Dimensions="0" />
          <Parameter Name="Mean" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="Deviation" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="ColumnMean" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="RowMean" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="PlaneMean" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="LocalMean" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="LocalDeviation" DataType="REAL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
          <Parameter Name="Ready" DataType="BOOL" Usage="Output" Required="false" Visible="true" Dimensions="0" />
        </Parameters>
        <LocalTags>
          <LocalTag Name="Scratch" DataType="REAL" Dimensions="6" />
          <LocalTag Name="LocalMeanState" DataType="CONTROL" />
          <LocalTag Name="LocalDeviationState" DataType="CONTROL" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Calculate)AVE(Samples[Index],0,Mean,MeanState,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Calculate)STD(Samples[Index],0,Deviation,DeviationState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Calculate)AVE(Grid[0,Column],0,ColumnMean,ColumnState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Calculate)AVE(Grid[Row,0],1,RowMean,RowState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Calculate)AVE(Cube[0,1,Index],0,PlaneMean,PlaneState,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(Calculate)AVE(Scratch[Index],0,LocalMean,LocalMeanState,?,?);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(Calculate)STD(Scratch[Index],0,LocalDeviation,LocalDeviationState,?,?);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(MeanState.DN)XIC(DeviationState.DN)OTE(Ready);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EnableInFalse" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>AFI()AVE(Samples[Index],0,Mean,MeanState,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>AFI()STD(Samples[Index],0,Deviation,DeviationState,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>AFI()AVE(Grid[0,Column],0,ColumnMean,ColumnState,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>AFI()AVE(Grid[Row,0],1,RowMean,RowState,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>AFI()AVE(Cube[0,1,Index],0,PlaneMean,PlaneState,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>AFI()AVE(Scratch[Index],0,LocalMean,LocalMeanState,?,?);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>AFI()STD(Scratch[Index],0,LocalDeviation,LocalDeviationState,?,?);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>AFI()OTE(Ready);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
