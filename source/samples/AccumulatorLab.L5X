      </Tag>
      <Tag Name="Total" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Integral" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ElapsedSeconds" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="HighAlarm" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="LowAlarm" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="TotalState" TagType="Base" DataType="UP_DOWN_ACCUM" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="UP_DOWN_ACCUM">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="InPlus" DataType="REAL" Value="0.0" />
            <DataValueMember Name="InMinus" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Initialize" DataType="BOOL" Value="0" />
            <DataValueMember Name="InitialValue" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Hold" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="IntegralState" TagType="Base" DataType="INTEGRATOR" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="INTEGRATOR">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Initialize" DataType="BOOL" Value="0" />
            <DataValueMember Name="InitialValue" DataType="REAL" Value="0.0" />
            <DataValueMember Name="IGain" DataType="REAL" Value="0.0" />
            <DataValueMember Name="HighLimit" DataType="REAL" Value="3.4028234663852886e+38" />
            <DataValueMember Name="LowLimit" DataType="REAL" Value="-3.4028234663852886e+38" />
            <DataValueMember Name="HoldHigh" DataType="BOOL" Value="0" />
            <DataValueMember Name="HoldLow" DataType="BOOL" Value="0" />
            <DataValueMember Name="TimingMode" DataType="DINT" Value="0" />
            <DataValueMember Name="OversampleDT" DataType="REAL" Value="0.0" />
            <DataValueMember Name="RTSTime" DataType="DINT" Value="1" />
            <DataValueMember Name="RTSTimeStamp" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
            <DataValueMember Name="HighAlarm" DataType="BOOL" Value="0" />
            <DataValueMember Name="LowAlarm" DataType="BOOL" Value="0" />
            <DataValueMember Name="DeltaT" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF CallLogic THEN</Line>
              <Line Number="1">TotalState.InPlus:=Plus; TotalState.InMinus:=Minus;</Line>
              <Line Number="2">TotalState.Initialize:=InitializeTotal; TotalState.InitialValue:=InitialTotal; TotalState.Hold:=HoldTotal;</Line>
              <Line Number="3">IntegralState.In:=Input; IntegralState.IGain:=Gain;</Line>
              <Line Number="4">IntegralState.Initialize:=InitializeIntegral; IntegralState.InitialValue:=InitialIntegral;</Line>
              <Line Number="5">IntegralState.HoldHigh:=HoldHigh; IntegralState.HoldLow:=HoldLow;</Line>
              <Line Number="6">IntegralState.HighLimit:=HighLimit; IntegralState.LowLimit:=LowLimit;</Line>
              <Line Number="7">IntegralState.TimingMode:=1; IntegralState.OversampleDT:=SampleTime;</Line>
              <Line Number="8">UPDN(TotalState); INTG(IntegralState);</Line>
              <Line Number="9">CallCount:=CallCount+1;</Line>
              <Line Number="10">END_IF;</Line>
              <Line Number="11">Total:=TotalState.Out; Integral:=IntegralState.Out; ElapsedSeconds:=IntegralState.DeltaT;</Line>
              <Line Number="12">HighAlarm:=IntegralState.HighAlarm; LowAlarm:=IntegralState.LowAlarm;</Line>
              <Line Number="13">GuardResult:=1/FaultDivisor;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
