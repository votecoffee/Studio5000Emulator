    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(LogicInput)OTE(LogicOutput);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIO(LogicInput)OTE(LogicInverse);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(LogicInput)OTL(LogicLatched);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(LogicReset)OTU(LogicLatched);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(LogicInput)ONS(OneShotStorage)OTE(OneShotPulse);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(LogicInput)OSR(RiseStorage,RisePulse);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(LogicInput)OSF(FallStorage,FallPulse);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(Enable)MVM(SourceByte,Mask,Status);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>CLR(Packed)BTD(SourceByte,0,Packed,0,8)BTD(SourceWord,0,Packed,16,16);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>BTD(Packed,0,LowWord,0,16);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>BTD(Packed,24,HighByte,0,8);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>MVM(0,SourceByte,MixedMask);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>MOV(16#1234,Overlap)BTD(Overlap,0,Overlap,4,12);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>BTD(SourceWord,0,Truncated,12,32);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>MEQ(Status,Mask,SourceByte)OTE(BitOK);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(TransitionEnable)DTR(TransitionSource,TransitionMask,TransitionReference)OTE(TransitionPulse);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(TransitionPulse)ADD(TransitionCount,1,TransitionCount);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(CompareEnable)FBC(CompareSource[0],CompareReference[0],MismatchBits[0],CompareControl,?,?,CompareResultControl,?,?);</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>XIC(DetectEnable)DDT(CompareSource[0],LearnReference[0],ChangedBits[0],DetectControl,?,?,DetectResultControl,?,?);</Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Text>XIC(BitwiseWidths)AND(LogicByte,LogicDword,AndWidths);</Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text>XIC(BitwiseWidths)OR(LogicWord,LogicDword,OrWidths);</Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Text>XIC(BitwiseWidths)XOR(LogicByte,LogicDword,XorWidths);</Text>
              </Rung>
              <Rung Number="23" Type="N">
                <Text>XIC(BitwiseWidths)NOT(LogicByte,NotWidened);</Text>
              </Rung>
              <Rung Number="24" Type="N">
                <Text>XIC(BitwiseWidths)NOT(LogicDword,NotNarrowed);</Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Text>XIC(IndexedTransfers)MVM(TransferInputs[TransferIndex],-1,TransferMoved[TransferIndex]);</Text>
              </Rung>
              <Rung Number="26" Type="N">
                <Text>XIC(IndexedTransfers)BTD(TransferInputs[TransferIndex],8,TransferBits[TransferIndex],0,16);</Text>
              </Rung>
              <Rung Number="27" Type="N">
                <Text>XIC(MixedBitwise)AND(MixedSmall,MixedDwordMask,MixedAnd);</Text>
              </Rung>
              <Rung Number="28" Type="N">
                <Text>XIC(MixedBitwise)OR(MixedSmall,MixedWide,MixedOr);</Text>
              </Rung>
              <Rung Number="29" Type="N">
                <Text>XIC(MixedBitwise)XOR(MixedSigned,MixedDwordMask,MixedXor);</Text>
              </Rung>
              <Rung Number="30" Type="N">
                <Text>XIC(MixedBitwise)NOT(MixedSmall,MixedNot);</Text>
              </Rung>
              <Rung Number="31" Type="N">
                <Text>XIC(MixedBitwise)OR(MixedSigned,MixedSmall,MixedLow);</Text>
              </Rung>
              <Rung Number="32" Type="N"><Text>XIC(IndexMathEnabled)MOV(IndexMathValues[IndexMathBase/IndexMathDivisor],IndexMathResults[1]);</Text></Rung>
              <Rung Number="33" Type="N"><Text>XIC(IndexMathEnabled)MOV(IndexMathValues[IndexMathBase AND 3],IndexMathResults[2]);</Text></Rung>
              <Rung Number="34" Type="N"><Text>XIC(IndexMathEnabled)MOV(IndexMathValues[(IndexMathBase XOR 3) OR 1],IndexMathResults[3]);</Text></Rung>
              <Rung Number="35" Type="N"><Text>XIC(IndexMathEnabled)MOV(IndexMathValues[(NOT IndexMathBase) AND 7],IndexMathResults[4]);</Text></Rung>
              <Rung Number="36" Type="N"><Text>XIC(IndexMathEnabled)MOV(IndexMathValues[IndexMathWide],IndexMathResults[5]);</Text></Rung>
              <Rung Number="37" Type="N"><Text>XIC(IndexMathEnabled)EQU(IndexMathResults[1],33)EQU(IndexMathResults[2],33)EQU(IndexMathResults[3],55)EQU(IndexMathResults[4],10)EQU(IndexMathResults[5],33)OTE(IndexMathCheck);</Text></Rung>
              <Rung Number="38" Type="N"><Text>XIC(IndexMathEnabled)DIV(1,IndexMathLateDivisor,IndexMathLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
