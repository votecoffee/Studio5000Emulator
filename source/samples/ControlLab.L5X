    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Reset)RES(LeftControl)RES(RightControl)RES(QueueControl);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ShiftLeft)BSL(LeftBits[0],LeftControl,BitIn,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(ShiftRight)BSR(RightBits[0],RightControl,BitIn,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Load)FFL(Incoming,Queue[0],QueueControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Unload)FFU(Queue[0],Outgoing,QueueControl,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ZoneEnable)MCR();</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ZoneInput)OTE(ZoneOutput);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(ZoneInput)TON(ZoneTimer,?,?);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(ZoneInput)CTU(ZoneCounter,?,?);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(ZoneInput)OTL(ZoneLatch);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>ADD(ZoneScans,1,ZoneScans);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>DIV(1,ZoneDivisor,ZoneMath);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>MCR();</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>ADD(AfterZone,1,AfterZone);</Text>
              </Rung>
              <Rung Number="14" Type="N"><Text>JSR(IndirectOperands,0);</Text></Rung>
              <Rung Number="15" Type="N"><Text>JSR(NumericQueues,0);</Text></Rung>
              <Rung Number="16" Type="N"><Text>JSR(BcdFiles,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="IndirectOperands" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(IndexedShift)BSL(IndexedBits[0],IndexedShiftControl,PayloadBits[PayloadIndex],?);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(IndexedLoad)FFL(PayloadValues[PayloadIndex],IndexedQueue[0],IndexedQueueControl,?,?);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(IndexedUnload)FFU(IndexedQueue[0],UnloadedValues[OutputIndex],IndexedQueueControl,?,?);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(IndexedReset)RES(ResetControls[ResetControlIndex]);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="NumericQueues" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(MixedLoad)FFL(MixedSource,MixedQueue[0],MixedQueueControl,?,?);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(MixedUnload)FFU(MixedQueue[0],MixedResult,MixedQueueControl,?,?);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(MixedPush)LFL(MixedStackSource,MixedStack[0],MixedStackControl,?,?);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(MixedPop)LFU(MixedStack[0],MixedStackResult,MixedStackControl,?,?);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="BcdFiles" Type="RLL"><RLLContent>
            <Rung Number="0" Type="N"><Text>XIC(BcdFileReset)RES(BcdAllCalc)RES(BcdAllFind)RES(BcdNumericCalc)RES(BcdNumericFind)RES(BcdIncCalc)RES(BcdIncFind);</Text></Rung>
            <Rung Number="1" Type="N"><Text>XIC(BcdFileAll)FAL(BcdAllCalc,?,?,ALL,BcdDecoded[BcdAllCalc.POS],FRD(BcdPacked[BcdAllCalc.POS]));</Text></Rung>
            <Rung Number="2" Type="N"><Text>XIC(BcdFileAll)FSC(BcdAllFind,?,?,ALL,FRD(BcdPacked[BcdAllFind.POS])=BcdFindValue);</Text></Rung>
            <Rung Number="3" Type="N"><Text>XIC(BcdFileNumeric)FAL(BcdNumericCalc,?,?,2,BcdRepacked[BcdNumericCalc.POS],TOD(BcdDecimal[BcdNumericCalc.POS]));</Text></Rung>
            <Rung Number="4" Type="N"><Text>XIC(BcdFileNumeric)FSC(BcdNumericFind,?,?,2,FRD(TOD(BcdDecimal[BcdNumericFind.POS]))=BcdFindValue);</Text></Rung>
            <Rung Number="5" Type="N"><Text>XIC(BcdFileIncrement)FAL(BcdIncCalc,?,?,INC,BcdIncremented[BcdIncCalc.POS],FRD(TOD(BcdDecimal[BcdIncCalc.POS]))+1);</Text></Rung>
            <Rung Number="6" Type="N"><Text>XIC(BcdFileIncrement)FSC(BcdIncFind,?,?,INC,FRD(BcdPacked[BcdIncFind.POS])=BcdFindValue);</Text></Rung>
            <Rung Number="7" Type="N"><Text>DIV(1,BcdFileLateDivisor,BcdFileLateResult);</Text></Rung>
          </RLLContent></Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
