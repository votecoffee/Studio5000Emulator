        <Data Format="Decorated">
          <DataValue DataType="UDINT" Radix="Decimal" Value="99999999" />
        </Data>
      </Tag>
      <Tag Name="UnsignedPacked" DataType="UDINT" TagType="Base" ExternalAccess="Read/Write">
