          <DataValue DataType="ULINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="WeightedWide" DataType="ULINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="ULINT" Radix="Decimal" Value="18446744073709551615" />
        </Data>
      </Tag>
      <Tag Name="WideWeighted" DataType="ULINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
