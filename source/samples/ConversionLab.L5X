        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>JSR(SmallPacked,0)XIC(Enable)TOD(Decimal,Packed);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Enable)FRD(Packed,Decoded);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Enable)FRD(HexDigits,Weighted);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Enable)SWPB(ByteSource,REVERSE,Reverse)SWPB(ByteSource,WORD,Words)SWPB(ByteSource,HIGHLOW,HighLow);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Enable)SWPB(WordSource,HIGHLOW,SignExtended);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>JSR(SwapText,0);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>EQU(Decoded,Decimal)EQU(Weighted,12345684)EQU(SignExtended,-21742)EQU(SwappedWords[0],-21742)EQU(SwappedWords[1],255)OTE(AllOK);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(Enable)TOD(ByteDecimal,BytePacked)FRD(BytePacked,ByteDecoded);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(Enable)TOD(WordDecimal,WordPacked)FRD(WordPacked,WordDecoded);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(Enable)FRD(RawByteBCD,RawByteDecoded);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>EQU(ByteDecimal,ByteDecoded)EQU(WordDecimal,WordDecoded)OTE(NarrowOK);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(IndexedConversions)TOD(IndexedDecimal[ConversionIndex],IndexedPacked[ConversionIndex]);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(IndexedConversions)FRD(IndexedPacked[ConversionIndex],IndexedDecoded[ConversionIndex]);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(IndexedConversions)SWPB(IndexedPacked[ConversionIndex],WORD,IndexedSwapped[ConversionIndex]);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(WideConversions)TOD(WideDecimal,WidePacked)FRD(WidePacked,WideDecoded);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(WideConversions)TOD(WideDecimal,SignedPacked)FRD(SignedPacked,SignedDecoded);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(WideConversions)FRD(WeightedWide,WideWeighted);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(WideConversions)TOD(UnsignedDecimal,UnsignedPacked)FRD(UnsignedPacked,UnsignedDecoded);</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>XIC(WideConversions)EQU(WideDecimal,WideDecoded)EQU(WideDecimal,SignedDecoded)OTE(WideOK);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="SwapText" Type="ST">
            <STContent>
              <Line Number="0">SWPB(ByteSource,HIGHLOW,STValue);</Line>
              <Line Number="1">FOR Index:=0 TO 1 DO</Line>
              <Line Number="2">SWPB(InputWords[Index],REVERSE,SwappedWords[Index]);</Line>
              <Line Number="3">END_FOR;</Line>
            </STContent>
          </Routine>
          <Routine Name="SmallPacked" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(SmallBCD)TOD(SmallDecimal,SmallBytePacked[SmallBCDIndex])FRD(SmallBytePacked[SmallBCDIndex],SmallDecoded[0]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(SmallBCD)TOD(SmallDecimal,SmallByteUnsigned)FRD(SmallByteUnsigned,SmallDecoded[1]);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(SmallBCD)TOD(SmallWordDecimal,SmallWordSigned)FRD(SmallWordSigned,SmallDecoded[2]);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(SmallBCD)TOD(SmallWordDecimal,SmallWordUnsigned)FRD(SmallWordUnsigned,SmallDecoded[3]);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
