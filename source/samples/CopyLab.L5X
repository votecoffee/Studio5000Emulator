        </Data>
      </Tag>
      <Tag Name="Roundtrip" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CopyLength" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="20" />
        </Data>
      </Tag>
      <Tag Name="EnableCopy" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Bytes" TagType="Base" DataType="SINT" Dimensions="5">
        <Data Format="Decorated">
          <Array DataType="SINT" Dimensions="5">
            <Element Index="[0]">
              <DataValue DataType="SINT" Value="1" />
            </Element>
            <Element Index="[1]">
              <DataValue DataType="SINT" Value="2" />
            </Element>
            <Element Index="[2]">
              <DataValue DataType="SINT" Value="3" />
            </Element>
            <Element Index="[3]">
              <DataValue DataType="SINT" Value="4" />
            </Element>
            <Element Index="[4]">
              <DataValue DataType="SINT" Value="5" />
            </Element>
          </Array>
        </Data>
      </Tag>
      <Tag Name="Packed" TagType="Base" DataType="DINT" Dimensions="3">
        <Data Format="Decorated">
          <Array DataType="DINT" Dimensions="3">
            <Element Index="[0]">
              <DataValue DataType="DINT" Value="0" />
            </Element>
            <Element Index="[1]">
              <DataValue DataType="DINT" Value="287454020" />
            </Element>
            <Element Index="[2]">
              <DataValue DataType="DINT" Value="1432778632" />
            </Element>
          </Array>
        </Data>
      </Tag>
      <Tag Name="DecodedBytes" TagType="Base" DataType="SINT" Dimensions="8">
        <Data Format="Decorated">
          <Array DataType="SINT" Dimensions="8">
            <Element Index="[0]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[1]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[2]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[3]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[4]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[5]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[6]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
            <Element Index="[7]">
              <DataValue DataType="SINT" Value="0" />
            </Element>
          </Array>
        </Data>
      </Tag>
      <Tag Name="UnpackedWords" TagType="Base" DataType="INT" Dimensions="4">
        <Data Format="Decorated">
          <Array DataType="INT" Dimensions="4">
            <Element Index="[0]">
              <DataValue DataType="INT" Value="0" />
            </Element>
            <Element Index="[1]">
              <DataValue DataType="INT" Value="0" />
            </Element>
            <Element Index="[2]">
              <DataValue DataType="INT" Value="0" />
            </Element>
            <Element Index="[3]">
              <DataValue DataType="INT" Value="0" />
