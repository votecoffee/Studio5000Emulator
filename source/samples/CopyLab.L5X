    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF EnableCopy THEN</Line>
              <Line Number="1">COP(FloatInput,BitPattern,1); CPS(IntegerInput,FloatOutput,1);</Line>
              <Line Number="2">COP(Bytes[0],Packed[0],CopyLength);</Line>
              <Line Number="3">COP(Packed[0],DecodedBytes[0],8);</Line>
              <Line Number="4">CPS(Packed[0],UnpackedWords[0],4);</Line>
              <Line Number="5">COP(BitPattern,Roundtrip,1); CallCount:=CallCount+1;</Line>
              <Line Number="6">END_IF;</Line>
              <Line Number="7">GuardResult:=1/FaultDivisor;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
