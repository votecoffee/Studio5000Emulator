    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF EnableCopy THEN</Line>
              <Line Number="1">COP(FloatInput,BitPattern,1); CPS(IntegerInput,FloatOutput,1);</Line>
              <Line Number="2">COP(Bytes[0],Packed[0],CopyLength);</Line>
              <Line Number="3">COP(Packed[0],DecodedBytes[0],8);</Line>
              <Line Number="4">CPS(Packed[0],UnpackedWords[0],4);</Line>
              <Line Number="5">COP(BitPattern,Roundtrip,1); CallCount:=CallCount+1;</Line>
              <Line Number="6">END_IF;</Line>
              <Line Number="7">GuardResult:=1/FaultDivisor;</Line>
              <Line Number="8">JSR(CopyIndexed,0);</Line>
              <Line Number="9">JSR(CopyDouble,0);</Line>
            </STContent>
          </Routine>
          <Routine Name="CopyIndexed" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(IndexedCopy)COP(SelectedSource[CopyIndex],SelectedBytes[OutputIndex],SelectedLength[0]);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(IndexedCopy)CPS(SelectedBytes[OutputIndex],SelectedRoundtrip[CopyIndex],1);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(IndexedCopy)EQU(SelectedSource[CopyIndex],SelectedRoundtrip[CopyIndex])OTE(CopyMatches);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="CopyDouble" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(DoubleCopy)COP(DoubleInput,DoubleImage,1);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(DoubleCopy)CPS(DoubleImage,DoubleRoundtrip,1);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(DoubleCopy)COP(DoubleInput,DoubleWords[0],2);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(DoubleCopy)CPS(DoubleWords[0],DoubleResults[DoubleCopyIndex],DoubleCopyLength);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(DoubleCopy)COP(DoubleLowWord,DoublePartial,1);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(DoubleCopy)XIC(DoubleInject)CPS(DoubleInjectedImage,DoubleRoundtrip,1);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(DoubleCopy)DIV(1,DoubleDivisor,DoubleLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
