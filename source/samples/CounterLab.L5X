<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="CounterLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="CounterLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="UpInput" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="DownInput" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ResetCounter" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCounter" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="Preset" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="3" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Count" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Done" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Overflow" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Underflow" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Counter" DataType="FBD_COUNTER" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="FBD_COUNTER">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="CUEnable" DataType="BOOL" Value="0" />
            <DataValueMember Name="CDEnable" DataType="BOOL" Value="0" />
            <DataValueMember Name="PRE" DataType="DINT" Value="3" />
            <DataValueMember Name="Reset" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="ACC" DataType="DINT" Value="0" />
            <DataValueMember Name="CU" DataType="BOOL" Value="0" />
            <DataValueMember Name="CD" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="OV" DataType="BOOL" Value="0" />
            <DataValueMember Name="UN" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="LadderCounter" TagType="Base" DataType="BOOL">
        <Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data>
      </Tag>
      <Tag Name="ResetCount" TagType="Base" DataType="BOOL">
        <Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data>
      </Tag>
      <Tag Name="CounterIndex" TagType="Base" DataType="DINT">
        <Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data>
      </Tag>
      <Tag Name="LadderDone" TagType="Base" DataType="BOOL">
        <Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data>
      </Tag>
      <Tag Name="ResetRecord" TagType="Base" DataType="BOOL">
        <Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data>
      </Tag>
      <Tag Name="ResetIndex" TagType="Base" DataType="DINT">
        <Data Format="Decorated"><DataValue DataType="DINT" Value="99" /></Data>
      </Tag>
      <Tag Name="LadderCounts" TagType="Base" DataType="COUNTER" Dimensions="3">
        <Data Format="Decorated">
          <Array DataType="COUNTER" Dimensions="3">
            <Element Index="[0]"><Structure DataType="COUNTER"><DataValueMember Name="PRE" DataType="DINT" Value="3" /></Structure></Element>
          </Array>
        </Data>
      </Tag>
      <Tag Name="ResetCounters" TagType="Base" DataType="COUNTER" Dimensions="3">
        <Data Format="Decorated"><Array DataType="COUNTER" Dimensions="3" /></Data>
      </Tag>
      <Tag Name="ResetTimers" TagType="Base" DataType="TIMER" Dimensions="3">
        <Data Format="Decorated"><Array DataType="TIMER" Dimensions="3" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF CallCounter THEN</Line>
              <Line Number="1">    Counter.PRE := Preset;</Line>
              <Line Number="2">    Counter.CUEnable := UpInput;</Line>
              <Line Number="3">    Counter.CDEnable := DownInput;</Line>
              <Line Number="4">    Counter.Reset := ResetCounter;</Line>
              <Line Number="5">    CTUD(Counter);</Line>
              <Line Number="6">    CallCount := CallCount + 1;</Line>
              <Line Number="7">END_IF;</Line>
              <Line Number="8">Count := Counter.ACC;</Line>
              <Line Number="9">Done := Counter.DN;</Line>
              <Line Number="10">Overflow := Counter.OV;</Line>
              <Line Number="11">Underflow := Counter.UN;</Line>
              <Line Number="12">GuardResult := 1 / FaultDivisor;</Line>
              <Line Number="13">IF LadderCounter THEN</Line>
              <Line Number="14">    JSR(CountLadder,0);</Line>
              <Line Number="15">END_IF;</Line>
              <Line Number="16">JSR(ResetLadderRecords,0);</Line>
            </STContent>
          </Routine>
          <Routine Name="CountLadder" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ResetCount)RES(LadderCounts[CounterIndex]);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(UpInput)CTU(LadderCounts[CounterIndex],?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(DownInput)CTD(LadderCounts[CounterIndex],?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(LadderCounts[CounterIndex].DN)OTE(LadderDone);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ResetLadderRecords" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ResetRecord)RES(ResetCounters[ResetIndex]);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ResetRecord)RES(ResetTimers[ResetIndex]);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
