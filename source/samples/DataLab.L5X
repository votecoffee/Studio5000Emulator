    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(MoveNumeric)MOV(MoveSource,MoveByte);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(MoveNumeric)MOV(MoveSource,MoveWord);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(MoveNumeric)MOV(SignSource,MoveUnsigned);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(MoveNumeric)MOV(MoveReal,MoveRealResult);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(MoveNumeric)MOV(MoveReal,MoveRounded);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(MoveNumeric)CLR(ClearValue);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(MoveNumeric)MOV(MoveSource,ByteFill[FillIndex]);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(CompareEnable)MEQ(CompareValues[CompareIndex],CompareValues[1],CompareValues[2])OTE(MaskedMatch);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(CompareEnable)LIM(0,CompareValues[CompareIndex],5000)OTE(InRange);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(CompareEnable)EQU(CompareValues[CompareIndex],4660)OTE(CompareEqual);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(InspectData)SIZE(Grid[1,2],1,SizeResult);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(InspectData)SIZE(Message.DATA[0],0,StringCapacity);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(InspectData)TRN(FillReal,TruncatedWide);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(InspectData)TRN(FillReal,TruncatedUnsigned);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(FillNumeric)FLL(FillSource,ByteFill[FillIndex],FillLength);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(FillNumeric)FLL(FillSource,WordFill[FillIndex],FillLength);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(FillNumeric)FLL(SignSource,SignedFill[FillIndex],FillLength);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(FillNumeric)FLL(FillReal,RealFill[FillIndex],FillLength);</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>XIC(FillAggregates)FLL(AggregateSource[0],ZeroRecords[AggregateIndex],AggregateLength[0]);</Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text>XIC(FillAggregates)FLL(AggregateSource[0],ZeroTimers[AggregateIndex],AggregateLength[0]);</Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Text>XIC(FillAggregates)FLL(AggregateSource[0],ZeroCounters[AggregateIndex],AggregateLength[0]);</Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text>XIC(FillAggregates)FLL(AggregateSource[0],ZeroStrings[AggregateIndex],AggregateLength[0]);</Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Text>XIC(CopyAggregates)COP(ZeroRecords[AggregateCopySourceIndex],CopyRecords[AggregateCopyDestIndex],AggregateCopyLength[0]);</Text>
              </Rung>
              <Rung Number="23" Type="N">
                <Text>XIC(CopyAggregates)CPS(ZeroTimers[AggregateCopySourceIndex],CopyTimers[AggregateCopyDestIndex],AggregateCopyLength[0]);</Text>
              </Rung>
              <Rung Number="24" Type="N">
                <Text>XIC(CopyAggregates)COP(ZeroStrings[AggregateCopySourceIndex],CopyStrings[AggregateCopyDestIndex],AggregateCopyLength[0]);</Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Comment>Initialize a numeric array once.</Comment>
                <Text>XIC(S:FS)FLL(7,Buffer[0],6);</Text>
              </Rung>
              <Rung Number="26" Type="N">
                <Comment>Copy six elements into a two-dimensional array.</Comment>
                <Text>XIC(CopyEnable)COP(Source[0],Buffer[0],6)CPS(Buffer[0],Grid[0,0],6);</Text>
              </Rung>
              <Rung Number="27" Type="N">
                <Comment>Read the second dimension length.</Comment>
                <Text>SIZE(Grid,1,Columns);</Text>
              </Rung>
              <Rung Number="28" Type="N">
                <Comment>Evaluate an expression with an indexed array operand.</Comment>
                <Text>CPT(Scaled,(Grid[Index,1]+5)*2.0);</Text>
              </Rung>
              <Rung Number="29" Type="N">
                <Comment>Build text from a numeric value.</Comment>
                <Text>DTOS(Grid[Index,1],NumberText)CONCAT(Prefix,NumberText,Message);</Text>
              </Rung>
              <Rung Number="30" Type="N">
                <Comment>Extract text and convert a string back to a number.</Comment>
                <Text>MID(Message,3,1,Snippet)STOD(NumberText,ParsedNumber);</Text>
              </Rung>
              <Rung Number="31" Type="N">
                <Comment>Preserve wide integer values and read an unsigned word bit.</Comment>
                <Text>MOV(WideSource,WideDest)XIC(PackedStatus.15)OTE(HighBit);</Text>
              </Rung>
              <Rung Number="32" Type="N">
                <Comment>Prepare a bounded loop.</Comment>
                <Text>CLR(LoopCount);</Text>
              </Rung>
              <Rung Number="33" Type="N">
                <Comment>Repeat until the count reaches three.</Comment>
                <Text>LBL(Again)ADD(LoopCount,1,LoopCount)LES(LoopCount,3)JMP(Again);</Text>
              </Rung>
              <Rung Number="34" Type="N">
                <Comment>Zero-fill a negative signed byte before applying a wide mask.</Comment>
                <Text>XIC(MixedCompare)MEQ(MixedSmall,MixedMask,MixedExpected)OTE(MixedMaskMatch);</Text>
              </Rung>
              <Rung Number="35" Type="N">
                <Comment>Compare adjacent exact signed and unsigned 64-bit values.</Comment>
                <Text>XIC(MixedCompare)MEQ(MixedExact,MixedFullMask,MixedExpectedExact)OTE(MixedExactMatch);</Text>
              </Rung>
              <Rung Number="36" Type="N">
                <Comment>Zero-fill a negative DINT before comparing its wide pattern.</Comment>
                <Text>XIC(MixedCompare)MEQ(MixedNarrow,MixedFullMask,MixedExpected)OTE(MixedWidthMatch);</Text>
              </Rung>
              <Rung Number="37" Type="N">
                <Comment>Skip the next write when Bypass is set.</Comment>
                <Text>XIC(Bypass)JMP(Finish);</Text>
              </Rung>
              <Rung Number="38" Type="N">
                <Comment>This write is skipped in the default demo.</Comment>
                <Text>MOV(999,SkippedValue);</Text>
              </Rung>
              <Rung Number="39" Type="N">
                <Comment>Temporary end exits only this routine.</Comment>
                <Text>LBL(Finish)XIC(EarlyReturn)TND();</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>