      <Tag Name="SignedFill" DataType="DINT" Dimensions="5" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Array DataType="DINT" Dimensions="5">
            <Element Index="[0]" Value="301" />
            <Element Index="[1]" Value="0" />
            <Element Index="[2]" Value="0" />
            <Element Index="[3]" Value="0" />
            <Element Index="[4]" Value="399" />
          </Array>
        </Data>
      </Tag>
      <Tag Name="RealFill" DataType="INT" Dimensions="5" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Array DataType="INT" Dimensions="5">
            <Element Index="[0]" Value="401" />
            <Element Index="[1]" Value="0" />
            <Element Index="[2]" Value="0" />
            <Element Index="[3]" Value="0" />
            <Element Index="[4]" Value="499" />
          </Array>
        </Data>
      </Tag>
      <Tag Name="InspectData" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="SizeResult" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StringCapacity" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="TruncatedWide" DataType="LINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="LINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="TruncatedUnsigned" DataType="UDINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="UDINT" Value="0" />
