      <Tag Name="TimeoutDemoRuns" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="TimeoutDemoFirst" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="TimeoutDemoStatus" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="TimeoutDemoRateUs" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="TimeoutDemoEnabled" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="ApplyTimeoutDemoSettings" TagType="Base" DataType="BOOL"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="TimeoutDemoRateCommandUs" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="20000" /></Data></Tag>
      <Tag Name="TimeoutDemoEnableCommand" TagType="Base" DataType="DINT"><Data Format="Decorated"><DataValue DataType="DINT" Value="1" /></Data></Tag>
    </Tags>
    <Programs>
      <Program Name="ProducerProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(ProducerCount,1,ProducerCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(ProducerFirst,1,ProducerFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N"><Text>XIC(ControlEventInhibit)SSV(Task,WorkEvent,InhibitTask,EventInhibitCommand);</Text></Rung>
              <Rung Number="3" Type="N"><Text>[XIC(ControlEventInhibit),XIC(ReadEventConfig)]GSV(Task,WorkEvent,InhibitTask,LiveEventInhibit);</Text></Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(TriggerRLL)EVENT(WorkEvent);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>MOV(EventCount,RllSeen);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(TriggerDeferred)EVENT(DeferredEvent);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(TriggerDeferred)EVENT(DeferredEvent);</Text>
              </Rung>
              <Rung Number="8" Type="N"><Text>XIC(ControlDeferredInhibit)SSV(Task,DeferredEvent,InhibitTask,DeferredInhibitCommand);</Text></Rung>
              <Rung Number="9" Type="N"><Text>[XIC(ControlDeferredInhibit),XIC(ReadEventConfig)]GSV(Task,DeferredEvent,InhibitTask,LiveDeferredInhibit);</Text></Rung>
              <Rung Number="10" Type="N">
                <Text>MOV(DeferredCount,RllDeferredSeen);</Text>
              </Rung>
              <Rung Number="11" Type="N"><Text>XIC(GuardEvents)JSR(GuardedEvent,0);</Text></Rung>
              <Rung Number="12" Type="N"><Text>JSR(ReadEventStatus,0);</Text></Rung>
              <Rung Number="13" Type="N"><Text>JSR(ReadEventTimings,0);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(TriggerTimeoutDemo)EVENT(TimeoutDemoEvent);</Text></Rung>
              <Rung Number="15" Type="N"><Text>XIC(ApplyTimeoutDemoSettings)SSV(Task,TimeoutDemoEvent,Rate,TimeoutDemoRateCommandUs);</Text></Rung>
              <Rung Number="16" Type="N"><Text>XIC(ApplyTimeoutDemoSettings)SSV(Task,TimeoutDemoEvent,EnableTimeOut,TimeoutDemoEnableCommand);</Text></Rung>
              <Rung Number="17" Type="N"><Text>XIC(ApplyTimeoutDemoSettings)GSV(Task,TimeoutDemoEvent,Rate,TimeoutDemoRateUs);</Text></Rung>
              <Rung Number="18" Type="N"><Text>XIC(ApplyTimeoutDemoSettings)GSV(Task,TimeoutDemoEvent,EnableTimeOut,TimeoutDemoEnabled);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="GuardedEvent" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>UID()UID()EVENT(WorkEvent)MOV(EventCount,GuardSeen);</Text></Rung>
              <Rung Number="1" Type="N"><Text>UIE()MOV(EventCount,GuardSeen);</Text></Rung>
              <Rung Number="2" Type="N"><Text>UIE()MOV(EventCount,ReleasedSeen);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadEventStatus" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadEventStatus)GSV(Task,WorkEvent,Status,EventStatusWords[EventStatusIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadEventStatus)GSV(Task,WorkEvent,Status,NamedWorkStatus);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadOverlap)GSV(Task,WorkEvent,OverlapCount,OverlapWords[OverlapIndex]);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadOverlap)GSV(Task,WorkEvent,OverlapCount,NamedOverlap);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadEventTimings" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,WorkEvent,LastScanTime,EventTimingWords[EventTimingIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,WorkEvent,MaxScanTime,WorkTaskMax);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,DeferredEvent,LastScanTime,DeferredTaskLast);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,DeferredEvent,MaxScanTime,DeferredTaskMax);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ReadEventTiming)GSV(Program,EventProgram,LastScanTime,NamedWorkProgramLast);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="BackgroundProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="ST">
            <STContent>
              <Line Number="0">BackgroundCount:=BackgroundCount+1;</Line>
              <Line Number="1">IF S:FS THEN BackgroundFirst:=BackgroundFirst+1; END_IF;</Line>
              <Line Number="2">IF TriggerST THEN EVENT(WorkEvent); END_IF;</Line>
              <Line Number="3">StSeen:=EventCount;</Line>
              <Line Number="4">StDeferredSeen:=DeferredCount;</Line>
              <Line Number="5">IF ReadEventStatus THEN GSV(Task,WorkEvent,Status,StWorkStatus); GSV(Task,DeferredEvent,Status,DeferredStatus); IF ClearEventStatus THEN SSV(Task,WorkEvent,Status,EventStatusCommand); END_IF; END_IF;</Line>
              <Line Number="6">IF ReadEventStatus THEN StatusResult:=1/StatusDivisor; END_IF;</Line>
              <Line Number="7">IF ControlEventInhibit OR ControlDeferredInhibit OR SelfInhibitEvent THEN InhibitResult:=1/InhibitDivisor; END_IF;</Line>
              <Line Number="8">IF ReadEventTiming THEN GSV(Task,WorkEvent,LastScanTime,StWorkTaskLast); GSV(Task,DeferredEvent,LastScanTime,StDeferredTaskLast); END_IF;</Line>
              <Line Number="9">IF ReadEventTiming THEN TimingResult:=1/TimingDivisor; END_IF;</Line>
              <Line Number="10">IF ReadOverlap THEN GSV(Task,WorkEvent,OverlapCount,StOverlap); IF ResetOverlap THEN SSV(Task,WorkEvent,OverlapCount,OverlapResetValue); END_IF; END_IF;</Line>
              <Line Number="11">IF ReadOverlap THEN OverlapResult:=1/OverlapDivisor; END_IF;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="EventProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(EventCount,1,EventCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(EventFirst,1,EventFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>TON(EventTimer,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadEventStatus)GSV(Task,THIS,Status,WorkEntryStatus);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(SelfInhibitEvent)SSV(Task,THIS,InhibitTask,SelfInhibitCommand);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadEventConfig)GSV(Task,THIS,InhibitTask,ThisEventInhibit);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(ReadEventConfig)GSV(Task,THIS,Priority,ThisEventPriority);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(ReadEventConfig)GSV(Task,THIS,Watchdog,ThisEventWatchdog);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(ReadEventConfig)GSV(Task,THIS,Name,ThisEventTaskName);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(ReadOverlap)GSV(Task,THIS,OverlapCount,ThisOverlapBefore);</Text></Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(SelfTrigger)EVENT(WorkEvent);</Text>
              </Rung>
              <Rung Number="11" Type="N"><Text>XIC(ReadOverlap)GSV(Task,THIS,OverlapCount,ThisOverlapAfter);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(ReadOverlap)XIC(ResetOverlap)SSV(Task,THIS,OverlapCount,OverlapResetValue);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(ReadOverlap)GSV(Task,THIS,OverlapCount,ThisOverlapExit);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(ReadEventStatus)GSV(Task,THIS,Status,WorkActiveStatus);</Text></Rung>
              <Rung Number="15" Type="N"><Text>XIC(ReadEventStatus)XIC(ClearEventStatus)SSV(Task,THIS,Status,EventStatusCommand);</Text></Rung>
              <Rung Number="16" Type="N"><Text>XIC(ReadEventStatus)GSV(Task,THIS,Status,WorkExitStatus);</Text></Rung>
              <Rung Number="17" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,THIS,LastScanTime,ThisWorkTaskLast);</Text></Rung>
              <Rung Number="18" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,THIS,MaxScanTime,ThisWorkTaskMax);</Text></Rung>
              <Rung Number="19" Type="N"><Text>XIC(ReadEventTiming)GSV(Program,THIS,LastScanTime,ThisWorkProgramLast);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="DeferredProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(DeferredCount,1,DeferredCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(DeferredFirst,1,DeferredFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>TON(DeferredTimer,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadEventTiming)GSV(Task,THIS,LastScanTime,ThisDeferredTaskLast);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="TimeoutDemoProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>ADD(TimeoutDemoRuns,1,TimeoutDemoRuns);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(S:FS)ADD(TimeoutDemoFirst,1,TimeoutDemoFirst);</Text></Rung>
              <Rung Number="2" Type="N"><Text>GSV(Task,THIS,Status,TimeoutDemoStatus);</Text></Rung>
              <Rung Number="3" Type="N"><Text>GSV(Task,THIS,Rate,TimeoutDemoRateUs);</Text></Rung>
              <Rung Number="4" Type="N"><Text>GSV(Task,THIS,EnableTimeOut,TimeoutDemoEnabled);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="ProducerTask" Type="PERIODIC" Class="Standard" Priority="5" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false" Rate="10">
        <ScheduledPrograms>
          <ScheduledProgram Name="ProducerProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="BackgroundTask" Type="CONTINUOUS" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="BackgroundProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="WorkEvent" Type="EVENT" Class="Standard" Priority="1" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="true">
        <EventInfo EventTrigger="EVENT Instruction Only" EnableTimeout="false" />
        <ScheduledPrograms>
          <ScheduledProgram Name="EventProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="DeferredEvent" Type="EVENT" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="true">
        <EventInfo EventTrigger="EVENT Instruction Only" EnableTimeout="false" />
        <ScheduledPrograms>
          <ScheduledProgram Name="DeferredProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="TimeoutDemoEvent" Type="EVENT" Class="Standard" Priority="4" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="true" Rate="35">
        <EventInfo EventTrigger="EVENT Instruction Only" EnableTimeout="true" />
        <ScheduledPrograms>
          <ScheduledProgram Name="TimeoutDemoProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
