            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="SineState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
