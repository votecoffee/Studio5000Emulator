      <Tag Name="RootState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="NaturalState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="CommonState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="PowerState" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="RadiansState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
