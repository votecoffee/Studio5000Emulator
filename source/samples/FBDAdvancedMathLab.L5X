            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="CosineState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="TangentState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="ArcSineState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="ArcCosineState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="ArcTangentState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="DegreesState" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ExecuteGraph)JSR(AdvancedMath,0);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ExecuteGraph)ADD(CallCount,1,CallCount);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="AdvancedMath" Type="FBD">
            <FBDContent SheetSize="A3" SheetOrientation="Landscape">
              <Sheet Number="1">
                <Description>Finite REAL roots, logarithms, powers and degree/radian trigonometric signal chains.</Description>
                <IRef ID="1" X="20" Y="0" Operand="RootInput" />
                <IRef ID="2" X="20" Y="180" Operand="LogInput" />
                <IRef ID="3" X="20" Y="360" Operand="PowerBase" />
                <IRef ID="4" X="20" Y="540" Operand="PowerExponent" />
                <IRef ID="5" X="20" Y="720" Operand="AngleDegrees" />
                <IRef ID="6" X="20" Y="900" Operand="Ratio" />
                <IRef ID="7" X="20" Y="1080" Operand="Slope" />
                <IRef ID="8" X="20" Y="1260" Operand="BlockEnable" />
                <Block ID="100" X="350" Y="60" Type="SQR" Operand="RootState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="200" X="750" Y="60" Type="LN" Operand="NaturalState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="300" X="1150" Y="60" Type="LOG" Operand="CommonState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="400" X="350" Y="460" Type="XPY" Operand="PowerState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="500" X="750" Y="460" Type="RAD" Operand="RadiansState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="600" X="1150" Y="460" Type="SIN" Operand="SineState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="700" X="350" Y="860" Type="COS" Operand="CosineState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="800" X="750" Y="860" Type="TAN" Operand="TangentState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="900" X="1150" Y="860" Type="ASN" Operand="ArcSineState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="1000" X="350" Y="1260" Type="ACS" Operand="ArcCosineState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="1100" X="750" Y="1260" Type="ATN" Operand="ArcTangentState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="1200" X="1150" Y="1260" Type="DEG" Operand="DegreesState" VisiblePins="EnableIn Source EnableOut Dest" />
                <ORef ID="2000" X="1800" Y="0" Operand="Root" />
                <ORef ID="2001" X="1800" Y="120" Operand="NaturalLog" />
                <ORef ID="2002" X="1800" Y="240" Operand="CommonLog" />
                <ORef ID="2003" X="1800" Y="360" Operand="Power" />
                <ORef ID="2004" X="1800" Y="480" Operand="Radians" />
                <ORef ID="2005" X="1800" Y="600" Operand="Sine" />
                <ORef ID="2006" X="1800" Y="720" Operand="Cosine" />
                <ORef ID="2007" X="1800" Y="840" Operand="Tangent" />
                <ORef ID="2008" X="1800" Y="960" Operand="ArcSine" />
                <ORef ID="2009" X="1800" Y="1080" Operand="ArcCosine" />
                <ORef ID="2010" X="1800" Y="1200" Operand="ArcTangent" />
                <ORef ID="2011" X="1800" Y="1320" Operand="RecoveredDegrees" />
                <ORef ID="2012" X="1800" Y="1440" Operand="MathEnabled" />
                <Wire FromID="1" FromParam="In" ToID="100" ToParam="Source" />
                <Wire FromID="2" FromParam="In" ToID="200" ToParam="Source" />
                <Wire FromID="2" FromParam="In" ToID="300" ToParam="Source" />
                <Wire FromID="3" FromParam="In" ToID="400" ToParam="SourceA" />
                <Wire FromID="4" FromParam="In" ToID="400" ToParam="SourceB" />
                <Wire FromID="5" FromParam="In" ToID="500" ToParam="Source" />
                <Wire FromID="500" FromParam="Dest" ToID="600" ToParam="Source" />
                <Wire FromID="500" FromParam="Dest" ToID="700" ToParam="Source" />
                <Wire FromID="500" FromParam="Dest" ToID="800" ToParam="Source" />
                <Wire FromID="6" FromParam="In" ToID="900" ToParam="Source" />
                <Wire FromID="6" FromParam="In" ToID="1000" ToParam="Source" />
                <Wire FromID="7" FromParam="In" ToID="1100" ToParam="Source" />
                <Wire FromID="900" FromParam="Dest" ToID="1200" ToParam="Source" />
                <Wire FromID="8" FromParam="In" ToID="100" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="200" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="300" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="400" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="500" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="600" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="700" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="800" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="900" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="1000" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="1100" ToParam="EnableIn" />
                <Wire FromID="8" FromParam="In" ToID="1200" ToParam="EnableIn" />
                <Wire FromID="100" FromParam="Dest" ToID="2000" ToParam="Out" />
                <Wire FromID="200" FromParam="Dest" ToID="2001" ToParam="Out" />
                <Wire FromID="300" FromParam="Dest" ToID="2002" ToParam="Out" />
                <Wire FromID="400" FromParam="Dest" ToID="2003" ToParam="Out" />
                <Wire FromID="500" FromParam="Dest" ToID="2004" ToParam="Out" />
                <Wire FromID="600" FromParam="Dest" ToID="2005" ToParam="Out" />
                <Wire FromID="700" FromParam="Dest" ToID="2006" ToParam="Out" />
                <Wire FromID="800" FromParam="Dest" ToID="2007" ToParam="Out" />
                <Wire FromID="900" FromParam="Dest" ToID="2008" ToParam="Out" />
                <Wire FromID="1000" FromParam="Dest" ToID="2009" ToParam="Out" />
                <Wire FromID="1100" FromParam="Dest" ToID="2010" ToParam="Out" />
                <Wire FromID="1200" FromParam="Dest" ToID="2011" ToParam="Out" />
                <Wire FromID="400" FromParam="EnableOut" ToID="2012" ToParam="Out" />
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
