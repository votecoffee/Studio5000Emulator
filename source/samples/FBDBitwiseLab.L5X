      <Tag Name="AndState" TagType="Base" DataType="FBD_LOGICAL">
        <Data Format="Decorated">
          <Structure DataType="FBD_LOGICAL">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="DINT" Value="0" />
            <DataValueMember Name="SourceB" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="OrState" TagType="Base" DataType="FBD_LOGICAL">
        <Data Format="Decorated">
          <Structure DataType="FBD_LOGICAL">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="DINT" Value="0" />
            <DataValueMember Name="SourceB" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="XorState" TagType="Base" DataType="FBD_LOGICAL">
        <Data Format="Decorated">
          <Structure DataType="FBD_LOGICAL">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="DINT" Value="0" />
            <DataValueMember Name="SourceB" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="NotState" TagType="Base" DataType="FBD_CONVERT">
        <Data Format="Decorated">
          <Structure DataType="FBD_CONVERT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="MoveState" TagType="Base" DataType="FBD_MASKED_MOVE">
        <Data Format="Decorated">
          <Structure DataType="FBD_MASKED_MOVE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="Mask" DataType="DINT" Value="0" />
            <DataValueMember Name="Target" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="MatchState" TagType="Base" DataType="FBD_MASK_EQUAL">
        <Data Format="Decorated">
          <Structure DataType="FBD_MASK_EQUAL">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="Mask" DataType="DINT" Value="0" />
            <DataValueMember Name="Compare" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Choice" TagType="Base" DataType="SELECT">
        <Data Format="Decorated">
          <Structure DataType="SELECT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In1" DataType="REAL" Value="0.0" />
            <DataValueMember Name="In2" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SelectorIn" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="OnDelay" TagType="Base" DataType="FBD_TIMER">
        <Data Format="Decorated">
          <Structure DataType="FBD_TIMER">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="TimerEnable" DataType="BOOL" Value="0" />
            <DataValueMember Name="PRE" DataType="DINT" Value="0" />
            <DataValueMember Name="Reset" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="ACC" DataType="DINT" Value="0" />
            <DataValueMember Name="EN" DataType="BOOL" Value="0" />
            <DataValueMember Name="TT" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
          </Structure>
        </Data>
