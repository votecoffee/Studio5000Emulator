      <Tag Name="LessEqual" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="InRange" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="SelectedValue" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="TimerACC" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="TimerDone" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CompareEnabled" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="EqualState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="NotEqualState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="GreaterState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="GreaterEqualState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="LessState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="LessEqualState" TagType="Base" DataType="FBD_COMPARE">
        <Data Format="Decorated">
          <Structure DataType="FBD_COMPARE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="RangeState" TagType="Base" DataType="FBD_LIMIT">
        <Data Format="Decorated">
          <Structure DataType="FBD_LIMIT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="LowLimit" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Test" DataType="REAL" Value="0.0" />
            <DataValueMember Name="HighLimit" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Choice" TagType="Base" DataType="SELECT">
        <Data Format="Decorated">
          <Structure DataType="SELECT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In1" DataType="REAL" Value="0.0" />
            <DataValueMember Name="In2" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SelectorIn" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="OnDelay" TagType="Base" DataType="FBD_TIMER">
        <Data Format="Decorated">
          <Structure DataType="FBD_TIMER">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="TimerEnable" DataType="BOOL" Value="0" />
            <DataValueMember Name="PRE" DataType="DINT" Value="0" />
            <DataValueMember Name="Reset" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="ACC" DataType="DINT" Value="0" />
            <DataValueMember Name="EN" DataType="BOOL" Value="0" />
            <DataValueMember Name="TT" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ExecuteGraph)JSR(CompareSignals,0);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ExecuteGraph)ADD(CallCount,1,CallCount);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="CompareSignals" Type="FBD">
            <FBDContent SheetSize="A3" SheetOrientation="Landscape">
              <Sheet Number="1">
                <Description>Finite REAL comparisons produce BOOL conditions for analog selection and an in-range on-delay timer.</Description>
                <IRef ID="1" X="20" Y="0" Operand="A" />
                <IRef ID="2" X="20" Y="130" Operand="B" />
                <IRef ID="3" X="20" Y="260" Operand="LowLimit" />
                <IRef ID="4" X="20" Y="390" Operand="HighLimit" />
                <IRef ID="5" X="20" Y="520" Operand="OffValue" />
                <IRef ID="6" X="20" Y="650" Operand="OnValue" />
                <IRef ID="7" X="20" Y="780" Operand="ResetTimer" />
                <IRef ID="8" X="20" Y="910" Operand="TimerPreset" />
                <IRef ID="9" X="20" Y="1040" Operand="BlockEnable" />
                <Block ID="100" X="360" Y="50" Type="EQU" Operand="EqualState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="200" X="740" Y="50" Type="NEQ" Operand="NotEqualState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="300" X="1120" Y="50" Type="GRT" Operand="GreaterState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="400" X="360" Y="600" Type="GEQ" Operand="GreaterEqualState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="500" X="740" Y="600" Type="LES" Operand="LessState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="600" X="1120" Y="600" Type="LEQ" Operand="LessEqualState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="700" X="360" Y="1150" Type="LIM" Operand="RangeState" VisiblePins="EnableIn LowLimit Test HighLimit EnableOut Dest" />
                <Block ID="800" X="740" Y="1150" Type="SEL" Operand="Choice" VisiblePins="EnableIn In1 In2 SelectorIn EnableOut Out" />
                <Block ID="900" X="1120" Y="1150" Type="TONR" Operand="OnDelay" VisiblePins="EnableIn TimerEnable PRE Reset EnableOut ACC EN TT DN Status" />
                <ORef ID="1000" X="1650" Y="0" Operand="Equal" />
                <ORef ID="1001" X="1650" Y="120" Operand="NotEqual" />
                <ORef ID="1002" X="1650" Y="240" Operand="Greater" />
                <ORef ID="1003" X="1650" Y="360" Operand="GreaterEqual" />
                <ORef ID="1004" X="1650" Y="480" Operand="Less" />
                <ORef ID="1005" X="1650" Y="600" Operand="LessEqual" />
                <ORef ID="1006" X="1650" Y="720" Operand="InRange" />
                <ORef ID="1007" X="1650" Y="840" Operand="SelectedValue" />
                <ORef ID="1008" X="1650" Y="960" Operand="TimerACC" />
                <ORef ID="1009" X="1650" Y="1080" Operand="TimerDone" />
                <ORef ID="1010" X="1650" Y="1200" Operand="CompareEnabled" />
                <Wire FromID="1" FromParam="In" ToID="100" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="100" ToParam="SourceB" />
                <Wire FromID="1" FromParam="In" ToID="200" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="200" ToParam="SourceB" />
                <Wire FromID="1" FromParam="In" ToID="300" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="300" ToParam="SourceB" />
                <Wire FromID="1" FromParam="In" ToID="400" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="400" ToParam="SourceB" />
                <Wire FromID="1" FromParam="In" ToID="500" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="500" ToParam="SourceB" />
                <Wire FromID="1" FromParam="In" ToID="600" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="600" ToParam="SourceB" />
                <Wire FromID="3" FromParam="In" ToID="700" ToParam="LowLimit" />
                <Wire FromID="1" FromParam="In" ToID="700" ToParam="Test" />
                <Wire FromID="4" FromParam="In" ToID="700" ToParam="HighLimit" />
                <Wire FromID="300" FromParam="Dest" ToID="800" ToParam="SelectorIn" />
                <Wire FromID="5" FromParam="In" ToID="800" ToParam="In1" />
                <Wire FromID="6" FromParam="In" ToID="800" ToParam="In2" />
                <Wire FromID="700" FromParam="Dest" ToID="900" ToParam="TimerEnable" />
                <Wire FromID="7" FromParam="In" ToID="900" ToParam="Reset" />
                <Wire FromID="8" FromParam="In" ToID="900" ToParam="PRE" />
                <Wire FromID="9" FromParam="In" ToID="100" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="200" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="300" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="400" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="500" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="600" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="700" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="800" ToParam="EnableIn" />
                <Wire FromID="9" FromParam="In" ToID="900" ToParam="EnableIn" />
                <Wire FromID="100" FromParam="Dest" ToID="1000" ToParam="Out" />
                <Wire FromID="200" FromParam="Dest" ToID="1001" ToParam="Out" />
                <Wire FromID="300" FromParam="Dest" ToID="1002" ToParam="Out" />
                <Wire FromID="400" FromParam="Dest" ToID="1003" ToParam="Out" />
                <Wire FromID="500" FromParam="Dest" ToID="1004" ToParam="Out" />
                <Wire FromID="600" FromParam="Dest" ToID="1005" ToParam="Out" />
                <Wire FromID="700" FromParam="Dest" ToID="1006" ToParam="Out" />
                <Wire FromID="800" FromParam="Out" ToID="1007" ToParam="Out" />
                <Wire FromID="900" FromParam="ACC" ToID="1008" ToParam="Out" />
                <Wire FromID="900" FromParam="DN" ToID="1009" ToParam="Out" />
                <Wire FromID="300" FromParam="EnableOut" ToID="1010" ToParam="Out" />
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
