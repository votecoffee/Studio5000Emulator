<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="FBDConversionLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="FBDConversionLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Value" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="17.75" />
        </Data>
      </Tag>
      <Tag Name="Divisor" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="5" />
        </Data>
      </Tag>
      <Tag Name="DecimalInput" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="12345678" />
        </Data>
      </Tag>
      <Tag Name="RawBCD" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="305419902" />
        </Data>
      </Tag>
      <Tag Name="BlockEnable" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="ExecuteGraph" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Remainder" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Truncated" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="PackedBCD" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Roundtrip" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Decoded" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ConversionEnabled" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="RemainderState" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="TruncateState" TagType="Base" DataType="FBD_TRUNCATE">
        <Data Format="Decorated">
          <Structure DataType="FBD_TRUNCATE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="EncodeState" TagType="Base" DataType="FBD_CONVERT">
        <Data Format="Decorated">
          <Structure DataType="FBD_CONVERT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="RoundtripState" TagType="Base" DataType="FBD_CONVERT">
        <Data Format="Decorated">
          <Structure DataType="FBD_CONVERT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="DecodeState" TagType="Base" DataType="FBD_CONVERT">
        <Data Format="Decorated">
          <Structure DataType="FBD_CONVERT">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="DINT" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ExecuteGraph)JSR(ConvertSignals,0);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ExecuteGraph)ADD(CallCount,1,CallCount);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ConvertSignals" Type="FBD">
            <FBDContent SheetSize="A3" SheetOrientation="Landscape">
              <Sheet Number="1">
                <Description>Finite REAL remainder and truncation; signed DINT BCD encoding, roundtrip and weighted-nibble decoding.</Description>
                <IRef ID="1" X="20" Y="0" Operand="Value" />
                <IRef ID="2" X="20" Y="180" Operand="Divisor" />
                <IRef ID="3" X="20" Y="360" Operand="DecimalInput" />
                <IRef ID="4" X="20" Y="540" Operand="RawBCD" />
                <IRef ID="5" X="20" Y="720" Operand="BlockEnable" />
                <Block ID="100" X="350" Y="60" Type="MOD" Operand="RemainderState" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="200" X="750" Y="60" Type="TRN" Operand="TruncateState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="300" X="1150" Y="60" Type="TOD" Operand="EncodeState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="400" X="350" Y="660" Type="FRD" Operand="RoundtripState" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="500" X="750" Y="660" Type="FRD" Operand="DecodeState" VisiblePins="EnableIn Source EnableOut Dest" />
                <ORef ID="1000" X="1650" Y="0" Operand="Remainder" />
                <ORef ID="1001" X="1650" Y="160" Operand="Truncated" />
                <ORef ID="1002" X="1650" Y="320" Operand="PackedBCD" />
                <ORef ID="1003" X="1650" Y="480" Operand="Roundtrip" />
                <ORef ID="1004" X="1650" Y="640" Operand="Decoded" />
                <ORef ID="1005" X="1650" Y="800" Operand="ConversionEnabled" />
                <Wire FromID="1" FromParam="In" ToID="100" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="100" ToParam="SourceB" />
                <Wire FromID="100" FromParam="Dest" ToID="200" ToParam="Source" />
                <Wire FromID="3" FromParam="In" ToID="300" ToParam="Source" />
                <Wire FromID="300" FromParam="Dest" ToID="400" ToParam="Source" />
                <Wire FromID="4" FromParam="In" ToID="500" ToParam="Source" />
                <Wire FromID="5" FromParam="In" ToID="100" ToParam="EnableIn" />
                <Wire FromID="5" FromParam="In" ToID="200" ToParam="EnableIn" />
                <Wire FromID="5" FromParam="In" ToID="300" ToParam="EnableIn" />
                <Wire FromID="5" FromParam="In" ToID="400" ToParam="EnableIn" />
                <Wire FromID="5" FromParam="In" ToID="500" ToParam="EnableIn" />
                <Wire FromID="100" FromParam="Dest" ToID="1000" ToParam="Out" />
                <Wire FromID="200" FromParam="Dest" ToID="1001" ToParam="Out" />
                <Wire FromID="300" FromParam="Dest" ToID="1002" ToParam="Out" />
                <Wire FromID="400" FromParam="Dest" ToID="1003" ToParam="Out" />
                <Wire FromID="500" FromParam="Dest" ToID="1004" ToParam="Out" />
                <Wire FromID="300" FromParam="EnableOut" ToID="1005" ToParam="Out" />
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
