<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="FBDMathLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="FBDMathLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="A" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="6" />
        </Data>
      </Tag>
      <Tag Name="B" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="2" />
        </Data>
      </Tag>
      <Tag Name="Offset" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="Gain" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="3" />
        </Data>
      </Tag>
      <Tag Name="Divisor" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="3" />
        </Data>
      </Tag>
      <Tag Name="BlockEnable" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="ExecuteGraph" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" TagType="Base" DataType="DINT">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Sum" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Difference" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Product" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Quotient" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Negative" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Magnitude" TagType="Base" DataType="REAL">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="MathEnabled" TagType="Base" DataType="BOOL">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Adder" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Subtracter" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Multiplier" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Divider" TagType="Base" DataType="FBD_MATH">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="SourceA" DataType="REAL" Value="0.0" />
            <DataValueMember Name="SourceB" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Negater" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Absolute" TagType="Base" DataType="FBD_MATH_ADVANCED">
        <Data Format="Decorated">
          <Structure DataType="FBD_MATH_ADVANCED">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="Source" DataType="REAL" Value="0.0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Dest" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ExecuteGraph)JSR(ComputeSignals,0);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(ExecuteGraph)ADD(CallCount,1,CallCount);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ComputeSignals" Type="FBD">
            <FBDContent SheetSize="A3" SheetOrientation="Landscape">
              <Sheet Number="1">
                <Description>Finite REAL arithmetic chain: (A+B-Offset)*Gain/Divisor, negation and absolute value.</Description>
                <IRef ID="1" X="20" Y="0" Operand="A" />
                <IRef ID="2" X="20" Y="180" Operand="B" />
                <IRef ID="3" X="20" Y="360" Operand="Offset" />
                <IRef ID="4" X="20" Y="540" Operand="Gain" />
                <IRef ID="5" X="20" Y="720" Operand="Divisor" />
                <IRef ID="6" X="20" Y="900" Operand="BlockEnable" />
                <Block ID="100" X="350" Y="60" Type="ADD" Operand="Adder" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="200" X="730" Y="60" Type="SUB" Operand="Subtracter" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="300" X="1110" Y="60" Type="MUL" Operand="Multiplier" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="400" X="350" Y="660" Type="DIV" Operand="Divider" VisiblePins="EnableIn SourceA SourceB EnableOut Dest" />
                <Block ID="500" X="730" Y="660" Type="NEG" Operand="Negater" VisiblePins="EnableIn Source EnableOut Dest" />
                <Block ID="600" X="1110" Y="660" Type="ABS" Operand="Absolute" VisiblePins="EnableIn Source EnableOut Dest" />
                <ORef ID="900" X="1600" Y="0" Operand="Sum" />
                <ORef ID="901" X="1600" Y="160" Operand="Difference" />
                <ORef ID="902" X="1600" Y="320" Operand="Product" />
                <ORef ID="903" X="1600" Y="480" Operand="Quotient" />
                <ORef ID="904" X="1600" Y="640" Operand="Negative" />
                <ORef ID="905" X="1600" Y="800" Operand="Magnitude" />
                <ORef ID="906" X="1600" Y="960" Operand="MathEnabled" />
                <Wire FromID="1" FromParam="In" ToID="100" ToParam="SourceA" />
                <Wire FromID="2" FromParam="In" ToID="100" ToParam="SourceB" />
                <Wire FromID="100" FromParam="Dest" ToID="200" ToParam="SourceA" />
                <Wire FromID="3" FromParam="In" ToID="200" ToParam="SourceB" />
                <Wire FromID="200" FromParam="Dest" ToID="300" ToParam="SourceA" />
                <Wire FromID="4" FromParam="In" ToID="300" ToParam="SourceB" />
                <Wire FromID="300" FromParam="Dest" ToID="400" ToParam="SourceA" />
                <Wire FromID="5" FromParam="In" ToID="400" ToParam="SourceB" />
                <Wire FromID="400" FromParam="Dest" ToID="500" ToParam="Source" />
                <Wire FromID="500" FromParam="Dest" ToID="600" ToParam="Source" />
                <Wire FromID="6" FromParam="In" ToID="100" ToParam="EnableIn" />
                <Wire FromID="6" FromParam="In" ToID="200" ToParam="EnableIn" />
                <Wire FromID="6" FromParam="In" ToID="300" ToParam="EnableIn" />
                <Wire FromID="6" FromParam="In" ToID="400" ToParam="EnableIn" />
                <Wire FromID="6" FromParam="In" ToID="500" ToParam="EnableIn" />
                <Wire FromID="6" FromParam="In" ToID="600" ToParam="EnableIn" />
                <Wire FromID="100" FromParam="Dest" ToID="900" ToParam="Out" />
                <Wire FromID="200" FromParam="Dest" ToID="901" ToParam="Out" />
                <Wire FromID="300" FromParam="Dest" ToID="902" ToParam="Out" />
                <Wire FromID="400" FromParam="Dest" ToID="903" ToParam="Out" />
                <Wire FromID="500" FromParam="Dest" ToID="904" ToParam="Out" />
                <Wire FromID="600" FromParam="Dest" ToID="905" ToParam="Out" />
                <Wire FromID="400" FromParam="EnableOut" ToID="906" ToParam="Out" />
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
