<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="FBDTotalLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="FBDTotalLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
