    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(SignedInput,SignedDelta,SignedSum);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>DIV(SignedInput,Divisor,SignedQuotient);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>MOD(SignedInput,Divisor,SignedRemainder);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>ADD(UnsignedInput,UnsignedOne,UnsignedSum);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>NOT(UnsignedInput,UnsignedComplement);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>ADD(ByteInput,ByteStep,ByteSum);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>ADD(WordInput,WordStep,WordSum);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>ADD(DwordInput,DwordStep,DwordSum);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>GRT(SignedSum,SignedInput)OTE(ExactComparison);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>JSR(WideText,0);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>EQU(SignedSum,StSignedSum)EQU(SignedQuotient,StSignedQuotient)EQU(SignedRemainder,StSignedRemainder)EQU(UnsignedSum,StUnsignedSum)EQU(UnsignedComplement,StUnsignedComplement)EQU(ByteSum,StByteSum)EQU(WordSum,StWordSum)EQU(DwordSum,StDwordSum)XIC(StExactComparison)OTE(StAllMatches);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(MixedArithmetic)ADD(SignedInput,NarrowDelta,MixedSum);</Text>
                <Comment>Enable MixedArithmetic for exact mixed integer tags with a destination that covers all source type ranges.</Comment>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(MixedArithmetic)SUB(SignedInput,MixedSmall,MixedDifference);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(MixedArithmetic)MUL(NarrowSigned,MixedSmall,MixedProduct);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(MixedArithmetic)DIV(SignedInput,NarrowDivisor,MixedQuotient);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(MixedArithmetic)MOD(SignedInput,NarrowDivisor,MixedRemainder);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(MixedArithmetic)NEG(MixedSmall,MixedNegated);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(MixedArithmetic)ABS(NarrowSigned,MixedAbs);</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>XIC(MixedArithmetic)SUB(UnsignedInput,MixedSmall,MixedUnsignedDifference);</Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text>XIC(ArithmeticConstants)ADD(NarrowSigned,1,ConstantSum);</Text>
                <Comment>Enable ArithmeticConstants for bounded DINT constants, operand order, signed quotient/remainder and widening results.</Comment>
              </Rung>
              <Rung Number="20" Type="N">
                <Text>XIC(ArithmeticConstants)SUB(10,NarrowSigned,ConstantDifference);</Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text>XIC(ArithmeticConstants)MUL(NarrowSigned,3,ConstantProduct);</Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Text>XIC(ArithmeticConstants)DIV(NarrowSigned,3,ConstantQuotient);</Text>
              </Rung>
              <Rung Number="23" Type="N">
                <Text>XIC(ArithmeticConstants)MOD(NarrowSigned,3,ConstantRemainder);</Text>
              </Rung>
              <Rung Number="24" Type="N">
                <Text>XIC(ArithmeticConstants)ADD(MixedSmall,1,ConstantUnsignedSum);</Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Text>XIC(ArithmeticConstants)DIV(-2147483648,MixedSmall,ConstantReverseQuotient);</Text>
              </Rung>
              <Rung Number="26" Type="N">
                <Text>XIC(ArithmeticConstants)ABS(-2147483648,ConstantAbs);</Text>
              </Rung>
              <Rung Number="27" Type="N">
                <Text>XIC(MixedRelations)EQU(RelationDword,RelationExpected)OTE(RelationEqual);</Text>
                <Comment>Enable MixedRelations for read-only mixed integer ordering and limits whose highest-ranked tag type covers every source range.</Comment>
              </Rung>
              <Rung Number="28" Type="N">
                <Text>XIC(MixedRelations)NEQ(RelationWord,RelationExpected)OTE(RelationNotEqual);</Text>
              </Rung>
              <Rung Number="29" Type="N">
                <Text>XIC(MixedRelations)LES(NarrowSigned,RelationWord)OTE(RelationLess);</Text>
              </Rung>
              <Rung Number="30" Type="N">
                <Text>XIC(MixedRelations)LEQ(RelationDword,RelationExpected)OTE(RelationLessEqual);</Text>
              </Rung>
              <Rung Number="31" Type="N">
                <Text>XIC(MixedRelations)GRT(SignedInput,RelationDword)OTE(RelationGreater);</Text>
              </Rung>
              <Rung Number="32" Type="N">
                <Text>XIC(MixedRelations)GEQ(RelationExpected,RelationDword)OTE(RelationGreaterEqual);</Text>
              </Rung>
              <Rung Number="33" Type="N">
                <Text>XIC(MixedRelations)LIM(RelationLow,RelationDword,RelationExpected)OTE(RelationInRange);</Text>
              </Rung>
              <Rung Number="34" Type="N">
                <Text>XIC(MixedRelations)LIM(RelationLow,SignedInput,RelationHigh)OTE(RelationExactLimit);</Text>
              </Rung>
              <Rung Number="35" Type="N">
                <Text>XIC(MixedRelations)LIM(RelationReversedLow,RelationTest,RelationReversedHigh)OTE(RelationReversed);</Text>
              </Rung>
              <Rung Number="36" Type="N">
                <Text>XIC(RelationConstants)LIM(0,RelationDword,RelationExpected)OTE(LimitConstantLow);</Text>
                <Comment>Enable RelationConstants for mixed integer limits with bounded constants in every operand position.</Comment>
              </Rung>
              <Rung Number="37" Type="N">
                <Text>XIC(RelationConstants)LIM(RelationLow,5,RelationExpected)OTE(LimitConstantTest);</Text>
              </Rung>
              <Rung Number="38" Type="N">
                <Text>XIC(RelationConstants)LIM(RelationLow,RelationWord,2147483647)OTE(LimitConstantHigh);</Text>
              </Rung>
              <Rung Number="39" Type="N">
                <Text>XIC(RelationConstants)LIM(-2147483648,NarrowSigned,RelationExpected)OTE(LimitConstantMinimum);</Text>
              </Rung>
              <Rung Number="40" Type="N">
                <Text>XIC(RelationConstants)LIM(RelationReversedLow,RelationTest,2)OTE(LimitConstantReversed);</Text>
              </Rung>
              <Rung Number="41" Type="N">
                <Text>XIC(RelationConstants)LIM(RelationReversedLow,2,RelationReversedHigh)OTE(LimitConstantEndpoint);</Text>
              </Rung>
              <Rung Number="42" Type="N">
                <Text>XIC(RelationConstants)LIM(2147483647,RelationDword,RelationExpected)OTE(LimitConstantMaximum);</Text>
              </Rung>
              <Rung Number="43" Type="N">
                <Text>XIC(RelationConstants)LIM(0,SignedInput,RelationWord)OTE(LimitConstantExact);</Text>
              </Rung>
              <Rung Number="44" Type="N">
                <Text>XIC(MixedConditions)CMP(RelationExpected=RelationDword)OTE(MixedConditionEqual);</Text>
                <Comment>Enable MixedConditions for exact mixed integer comparisons and eager Boolean composition without arithmetic conversion.</Comment>
              </Rung>
              <Rung Number="45" Type="N">
                <Text>XIC(MixedConditions)CMP((SignedInput&gt;RelationDword)&amp;&amp;(NarrowSigned&lt;RelationWord))OTE(MixedConditionAnd);</Text>
              </Rung>
              <Rung Number="46" Type="N">
                <Text>XIC(MixedConditions)CMP((RelationWord&lt;&gt;RelationExpected)||(RelationLow&gt;SignedInput))OTE(MixedConditionOr);</Text>
              </Rung>
              <Rung Number="47" Type="N">
                <Text>XIC(MixedConditions)CMP(!(RelationExpected&lt;RelationDword))OTE(MixedConditionNot);</Text>
              </Rung>
              <Rung Number="48" Type="N">
                <Text>XIC(MixedConditions)CMP((RelationWord&lt;RelationExpected)^^(RelationLow&gt;SignedInput))OTE(MixedConditionXor);</Text>
              </Rung>
              <Rung Number="49" Type="N">
                <Text>XIC(MixedConditions)CMP((RelationExpected&gt;=RelationDword) AND (RelationLow&lt;=SignedInput))OTE(MixedConditionWords);</Text>
              </Rung>
              <Rung Number="50" Type="N">
                <Text>XIC(MixedConditions)CMP((SignedInput&gt;RelationDword)&amp;&amp;MixedRelations)OTE(MixedConditionGate);</Text>
              </Rung>
              <Rung Number="51" Type="N">
                <Text>XIC(MixedConditions)CMP((SignedInput=RelationHigh)&amp;&amp;(RelationWord=65535))OTE(MixedConditionExact);</Text>
              </Rung>
              <Rung Number="52" Type="N"><Text>JSR(DoubleStorage,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="DoubleStorage" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(EnableDouble)MOV(DoubleInput,DoubleCopies[DoubleIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(EnableDouble)MOV(DoubleInteger,DoubleFromInt);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(EnableDouble)MOV(DoubleInput,DoubleRounded);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(EnableDouble)MOV(DoubleInput,DoubleAsInteger);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(EnableDouble)CLR(DoubleClear);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(EnableDouble)DIV(1,DoubleDivisor,DoubleLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="WideText" Type="ST">
            <STContent>
              <Line Number="0">StSignedSum:=SignedInput+StDelta;</Line>
              <Line Number="1">StSignedQuotient:=SignedInput/StDivisor;</Line>
              <Line Number="2">StSignedRemainder:=SignedInput MOD StDivisor;</Line>
              <Line Number="3">StUnsignedSum:=UnsignedInput+UnsignedOne;</Line>
              <Line Number="4">StUnsignedComplement:=NOT UnsignedInput;</Line>
              <Line Number="5">StByteSum:=ByteInput+ByteStep;</Line>
              <Line Number="6">StWordSum:=WordInput+WordStep;</Line>
              <Line Number="7">StDwordSum:=DwordInput+DwordStep;</Line>
              <Line Number="8">StExactComparison:=StSignedSum&gt;SignedInput;</Line>
              <Line Number="9">StLiteralSigned:=-9223372036854775808L+StLiteralOffset;</Line>
              <Line Number="10">StLiteralUnsigned:=18446744073709551615UL;</Line>
              <Line Number="11">StLiteralDword:=4294967295U;</Line>
              <Line Number="12">StLiteralNot:=NOT 0UL;</Line>
              <Line Number="13">StLiteralQuotient:=18446744073709551615UL/StLiteralDivisor;</Line>
              <Line Number="14">StLiteralCheck:=StLiteralSigned=-9223372036854775808L;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
