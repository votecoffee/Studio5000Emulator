<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="MathLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="MathLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Enable" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="Input" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="-16" />
        </Data>
      </Tag>
      <Tag Name="Root" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="LogInput" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="100" />
        </Data>
      </Tag>
      <Tag Name="LogNatural" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Log10" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Base" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="2" />
        </Data>
      </Tag>
      <Tag Name="Power" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="3" />
        </Data>
      </Tag>
      <Tag Name="Powered" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Degrees" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="30" />
        </Data>
      </Tag>
      <Tag Name="Radians" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="RoundTrip" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Sine" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Cosine" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Tangent" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="UnitValue" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0.5" />
        </Data>
      </Tag>
      <Tag Name="ArcSine" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ArcCosine" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ArcTangent" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CptRoot" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StRoot" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StAngle" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="AllOK" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Enable)SQR(Input,Root);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Enable)LN(LogInput,LogNatural)LOG(LogInput,Log10);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Enable)XPY(Base,Power,Powered);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Enable)RAD(Degrees,Radians)DEG(Radians,RoundTrip);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Enable)SIN(Radians,Sine)COS(Radians,Cosine)TAN(Radians,Tangent);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(Enable)ASN(UnitValue,ArcSine)ACS(UnitValue,ArcCosine)ATN(UnitValue,ArcTangent);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(Enable)CPT(CptRoot,SQR(Input));</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>JSR(MathText,0);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>EQU(Root,CptRoot)EQU(Root,StRoot)EQU(Radians,StAngle)OTE(AllOK);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="MathText" Type="ST">
            <STContent>
              <Line Number="0">StRoot:=SQRT(Input);</Line>
              <Line Number="1">StAngle:=RAD(Degrees);</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
