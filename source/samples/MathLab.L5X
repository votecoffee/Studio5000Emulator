          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StRemainder" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CptRealQuotient" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StRealDestination" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="StRealQuotient" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CmpMatches" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="IntegerMathMatches" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ByteRoot" DataType="SINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="SINT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="WordRoot" DataType="INT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="INT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="DintRoot" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="RoundingInput" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="6.25" />
        </Data>
      </Tag>
      <Tag Name="RoundedRoot" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="RoundedPower" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="BasicMath" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicA" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="7" />
        </Data>
      </Tag>
      <Tag Name="BasicB" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="3" />
        </Data>
      </Tag>
      <Tag Name="BasicSum" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicDifference" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicProduct" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicQuotient" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicRemainder" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicNegative" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicAbsolute" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicAnd" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicOr" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicXor" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="BasicNot" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="RealModulo" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ModuloA" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="-7.5" />
        </Data>
      </Tag>
      <Tag Name="ModuloB" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="2" />
        </Data>
      </Tag>
      <Tag Name="ModuloResult" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ModuloRounded" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="IndexedMath" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="MathIndex" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="99" />
        </Data>
      </Tag>
      <Tag Name="IndexedInputs" DataType="REAL" Dimensions="3" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="3">
            <Element Index="[0]" Value="-16" />
            <Element Index="[1]" Value="9" />
            <Element Index="[2]" Value="16" />
          </Array>
        </Data>
      </Tag>
      <Tag Name="IndexedRoots" DataType="REAL" Dimensions="3" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="3">
          </Array>
        </Data>
      </Tag>
      <Tag Name="IndexedPowers" DataType="REAL" Dimensions="3" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="3">
          </Array>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(BasicMath)ADD(BasicA,BasicB,BasicSum);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(BasicMath)SUB(BasicA,BasicB,BasicDifference);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(BasicMath)MUL(BasicA,BasicB,BasicProduct);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(BasicMath)DIV(BasicA,BasicB,BasicQuotient);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(BasicMath)MOD(BasicA,BasicB,BasicRemainder);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(BasicMath)NEG(BasicA,BasicNegative);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(BasicMath)ABS(BasicA,BasicAbsolute);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(BasicMath)AND(BasicA,BasicB,BasicAnd);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(BasicMath)OR(BasicA,BasicB,BasicOr);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(BasicMath)XOR(BasicA,BasicB,BasicXor);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(BasicMath)NOT(BasicA,BasicNot);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(Enable)SQR(Input,Root);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(Enable)LN(LogInput,LogNatural)LOG(LogInput,Log10);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(Enable)XPY(Base,Power,Powered);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(Enable)RAD(Degrees,Radians)DEG(Radians,RoundTrip);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(Enable)SIN(Radians,Sine)COS(Radians,Cosine)TAN(Radians,Tangent);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(Enable)ASN(UnitValue,ArcSine)ACS(UnitValue,ArcCosine)ATN(UnitValue,ArcTangent);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(Enable)CPT(CptRoot,SQR(Input));</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>JSR(MathText,0);</Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text>EQU(Root,CptRoot)EQU(Root,StRoot)EQU(Radians,StAngle)OTE(AllOK);</Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Text>DIV(Dividend,Divisor,LadderQuotient)MOD(Dividend,Divisor,LadderRemainder)CPT(CptQuotient,Dividend/Divisor)CPT(CptRemainder,Dividend MOD Divisor)CPT(CptRealQuotient,Dividend/Divisor)CMP(Dividend/Divisor=LadderQuotient&amp;&amp;Dividend MOD Divisor=LadderRemainder)OTE(CmpMatches);</Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text>JSR(DivideText,0);</Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Text>EQU(LadderQuotient,CptQuotient)EQU(LadderQuotient,StQuotient)EQU(LadderRemainder,CptRemainder)EQU(LadderRemainder,StRemainder)EQU(CptRealQuotient,StRealQuotient)XIC(CmpMatches)OTE(IntegerMathMatches);</Text>
              </Rung>
              <Rung Number="23" Type="N">
                <Text>XIC(Enable)SQR(Input,ByteRoot)SQR(Input,WordRoot)SQR(Input,DintRoot);</Text>
              </Rung>
              <Rung Number="24" Type="N">
                <Text>XIC(Enable)SQR(RoundingInput,RoundedRoot)XPY(-2.5,1.0,RoundedPower);</Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Text>XIC(RealModulo)MOD(ModuloA,ModuloB,ModuloResult);</Text>
              </Rung>
              <Rung Number="26" Type="N">
                <Text>XIC(RealModulo)MOD(ModuloA,ModuloB,ModuloRounded);</Text>
              </Rung>
              <Rung Number="27" Type="N">
                <Text>XIC(IndexedMath)SQR(IndexedInputs[MathIndex],IndexedRoots[MathIndex]);</Text>
              </Rung>
              <Rung Number="28" Type="N">
                <Text>XIC(IndexedMath)XPY(IndexedInputs[MathIndex],2.0,IndexedPowers[MathIndex]);</Text>
              </Rung>
              <Rung Number="29" Type="N"><Text>JSR(LrealAdvanced,0);</Text></Rung>
              <Rung Number="30" Type="N"><Text>JSR(LrealTruncate,0);</Text></Rung>
              <Rung Number="31" Type="N"><Text>JSR(MixedPower,0);</Text></Rung>
              <Rung Number="32" Type="N"><Text>JSR(UnaryDouble,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="UnaryDouble" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(UnaryDoubleInputs[UnaryDoubleIndex],UnaryDoubleResults[UnaryDoubleIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(UnaryDoubleDint,UnaryDoubleDintRoot);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(UnaryDoubleReal,UnaryDoubleRealRoot);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(UnaryDoubleUlint,UnaryDoubleUnsignedRoot);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(UnaryDoubleSigned,UnaryDoubleSignedRoot);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(UnaryDoubleEnabled)SQR(9,UnaryDoubleLiteralRoot);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(UnaryDoubleEnabled)DEG(UnaryDoubleOne,UnaryDoubleDegrees);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(UnaryDoubleEnabled)RAD(90,UnaryDoubleRadians);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(UnaryDoubleEnabled)LN(UnaryDoubleOne,UnaryDoubleLn);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(UnaryDoubleEnabled)LOG(100,UnaryDoubleLog);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(UnaryDoubleEnabled)SIN(UnaryDoubleOne,UnaryDoubleSine);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(UnaryDoubleEnabled)COS(UnaryDoubleZero,UnaryDoubleCosine);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(UnaryDoubleEnabled)TAN(0,UnaryDoubleTangent);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(UnaryDoubleEnabled)ASN(UnaryDoubleOne,UnaryDoubleAsin);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(UnaryDoubleEnabled)ACS(UnaryDoubleZero,UnaryDoubleAcos);</Text></Rung>
              <Rung Number="15" Type="N"><Text>XIC(UnaryDoubleEnabled)ATN(UnaryDoubleOne,UnaryDoubleAtan);</Text></Rung>
              <Rung Number="16" Type="N"><Text>XIC(UnaryDoubleEnabled)XIC(UnaryDoubleDomainFault)LN(UnaryDoubleDomain,UnaryDoubleDomainResult);</Text></Rung>
              <Rung Number="17" Type="N"><Text>XIC(UnaryDoubleEnabled)XIC(UnaryDoubleLiteralFault)LN(0,UnaryDoubleLiteralResult);</Text></Rung>
              <Rung Number="18" Type="N"><Text>XIC(UnaryDoubleEnabled)XIC(UnaryDoubleOverflowFault)DEG(UnaryDoubleLarge,UnaryDoubleOverflowResult);</Text></Rung>
              <Rung Number="19" Type="N"><Text>XIC(UnaryDoubleEnabled)DIV(1,UnaryDoubleLateDivisor,UnaryDoubleLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="MixedPower" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerValues[MixedPowerIndex],MixedPowerExponent,MixedPowerResults[MixedPowerIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerPrecise,2,MixedPowerPrecision);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(MixedPowerEnabled)XPY(2,MixedPowerDoubleExponent,MixedPowerConstantBase);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerDint,MixedPowerDoubleExponent,MixedPowerDintResult);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerReal,MixedPowerDoubleExponent,MixedPowerRealResult);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerLint,MixedPowerOne,MixedPowerWideBaseResult);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerNegativeOne,MixedPowerWideExponent,MixedPowerWideExponentResult);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(MixedPowerEnabled)XPY(MixedPowerNegativeBase,MixedPowerExponent,MixedPowerNegativeResult);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(MixedPowerEnabled)XIC(MixedPowerDomainFault)XPY(MixedPowerNegativeBase,MixedPowerFraction,MixedPowerDomainResult);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(MixedPowerEnabled)XIC(MixedPowerOverflowFault)XPY(MixedPowerLarge,2,MixedPowerOverflowResult);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(MixedPowerEnabled)DIV(1,MixedPowerLateDivisor,MixedPowerLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="LrealAdvanced" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(LrealMath)SQR(LrealRootInput,LrealResults[LrealIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(LrealMath)MOV(LrealResults[LrealIndex],LrealSqr);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(LrealMath)LN(LrealLogInput,LrealLn);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(LrealMath)LOG(LrealLogInput,LrealLog);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(LrealMath)XPY(LrealPowerBase,LrealExponent,LrealPower);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(LrealMath)DEG(LrealRadians,LrealDeg);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(LrealMath)RAD(LrealDegrees,LrealRad);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(LrealMath)SIN(LrealRadians,LrealSin);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(LrealMath)COS(LrealRadians,LrealCos);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(LrealMath)TAN(LrealRadians,LrealTan);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(LrealMath)ASN(LrealInverse,LrealAsn);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(LrealMath)ACS(LrealInverse,LrealAcs);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(LrealMath)ATN(LrealInverse,LrealAtn);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(LrealMath)DIV(1,LrealLateDivisor,LrealLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="LrealTruncate" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(TrnEnabled)TRN(TrnInput,TrnResults[TrnIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(TrnEnabled)TRN(TrnInput,TrnDint);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(TrnEnabled)TRN(TrnSignedInput,TrnLint);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(TrnEnabled)TRN(TrnUnsignedInput,TrnUlint);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(TrnEnabled)TRN(Input,TrnFromReal);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(TrnEnabled)TRN(TrnInput,TrnReal);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(TrnEnabled)DIV(1,TrnDivisor,TrnLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="MathText" Type="ST">
            <STContent>
              <Line Number="0">StRoot:=SQRT(Input);</Line>
              <Line Number="1">StAngle:=RAD(Degrees);</Line>
            </STContent>
          </Routine>
          <Routine Name="DivideText" Type="ST">
            <STContent>
              <Line Number="0">StQuotient:=Dividend/StDivisor;</Line>
              <Line Number="1">StRemainder:=Dividend MOD StDivisor;</Line>
              <Line Number="2">StRealDestination:=Dividend/StDivisor;</Line>
              <Line Number="3">StRealQuotient:=(Dividend+0.0)/StDivisor;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
