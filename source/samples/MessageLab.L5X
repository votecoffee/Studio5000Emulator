      <Tag Name="ApplyIdentityAttribute" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="IdentityAttribute" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="3" /></Data></Tag>
      <Tag Name="SendIdentityRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="IdentityReply" DataType="SINT" TagType="Base" Dimensions="4">
        <Data Format="Decorated"><Array DataType="SINT" Dimensions="4">
          <Element Index="[0]" Value="-9" /><Element Index="[1]" Value="0" /><Element Index="[2]" Value="0" /><Element Index="[3]" Value="-9" />
        </Array></Data>
      </Tag>
      <Tag Name="IdentityControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Generic" ServiceCode="16#0E" ObjectType="16#01" TargetObject="1" AttributeNumber="16#04" RequestedLength="0" DestinationTag="IdentityReply[1]" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendIdentityAll" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="IdentityAllReply" DataType="SINT" TagType="Base" Dimensions="28">
        <Data Format="Decorated"><Array DataType="SINT" Dimensions="28">
          <Element Index="[0]" Value="-9" /><Element Index="[9]" Value="0" /><Element Index="[10]" Value="0" /><Element Index="[27]" Value="-9" />
        </Array></Data>
      </Tag>
      <Tag Name="IdentityAllControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Generic" ServiceCode="16#01" ObjectType="16#01" TargetObject="1" AttributeNumber="16#00" RequestedLength="0" DestinationTag="IdentityAllReply[1]" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SendLocalMessages" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="LocalEcho" DataType="DINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="CaptureReadFlags" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadFlagsSnapshot" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="0" /></Data></Tag>
      <Tag Name="SendWrite" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SendTyped" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SetReadIndices" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadLocalIndex" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="ReadRemoteIndex" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="1" /></Data></Tag>
      <Tag Name="ApplyReadTimeout" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadTimeoutUs" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="10000" /></Data></Tag>
      <Tag Name="ReadTimeoutEcho" DataType="TIME32" TagType="Base"><Data Format="Decorated"><DataValue DataType="TIME32" Value="0" /></Data></Tag>
      <Tag Name="CancelRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadValue" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="WriteValue" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="42" /></Data></Tag>
      <Tag Name="VirtualValue" DataType="DINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="DINT" Value="17" /></Data></Tag>
      <Tag Name="AlternateValue" DataType="DINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="DINT" Value="64" /></Data></Tag>
      <Tag Name="ReadControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="ReadValue" RemoteElement="VirtualValue" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="WriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="WriteValue" RemoteElement="VirtualValue" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="RealReadback" DataType="REAL" TagType="Base" Dimensions="3">
        <Data Format="Decorated"><Array DataType="REAL" Dimensions="3">
          <Element Index="[0]" Value="0.0" /><Element Index="[1]" Value="0.0" /><Element Index="[2]" Value="0.0" />
        </Array></Data>
      </Tag>
      <Tag Name="WideSource" DataType="LINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="LINT" Value="9007199254740993" /></Data></Tag>
      <Tag Name="RealReadControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="RealReadback[*]" LocalIndex="0" RemoteElement="Program:MainProgram.Samples[*]" RemoteIndex="1" RequestedLength="2" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="WideWriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="WideSource" RemoteElement="Program:MainProgram.WideTarget" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendGridRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="GridReadback" DataType="DINT" TagType="Base" Dimensions="2,3">
        <Data Format="Decorated"><Array DataType="DINT" Dimensions="2,3">
          <Element Index="[0,0]" Value="-1" /><Element Index="[0,1]" Value="-1" /><Element Index="[0,2]" Value="0" />
          <Element Index="[1,0]" Value="0" /><Element Index="[1,1]" Value="0" /><Element Index="[1,2]" Value="-1" />
        </Array></Data>
      </Tag>
      <Tag Name="GridReadControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="GridReadback[0,2]" RemoteElement="Program:MainProgram.Grid[0,2]" RequestedLength="3" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendRecord" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="RecordSource" DataType="MessageRecord" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated"><Structure DataType="MessageRecord">
          <DataValueMember Name="Batch" DataType="DINT" Value="73" />
          <DataValueMember Name="Lot" DataType="LINT" Value="9007199254740993" />
          <DataValueMember Name="Ready" DataType="BOOL" Value="1" />
          <ArrayMember Name="Samples" DataType="INT" Dimensions="2"><Element Index="[0]" Value="12" /><Element Index="[1]" Value="-3" /></ArrayMember>
          <StructureMember Name="Quality" DataType="MessageQuality">
            <DataValueMember Name="Value" DataType="REAL" Value="2.5" />
            <DataValueMember Name="Code" DataType="INT" Value="7" />
          </StructureMember>
        </Structure></Data>
      </Tag>
      <Tag Name="RecordEcho" DataType="MessageRecord" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated"><Structure DataType="MessageRecord">
          <DataValueMember Name="Batch" DataType="DINT" Value="0" />
          <DataValueMember Name="Lot" DataType="LINT" Value="0" />
          <DataValueMember Name="Ready" DataType="BOOL" Value="0" />
          <ArrayMember Name="Samples" DataType="INT" Dimensions="2"><Element Index="[0]" Value="0" /><Element Index="[1]" Value="0" /></ArrayMember>
          <StructureMember Name="Quality" DataType="MessageQuality">
            <DataValueMember Name="Value" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Code" DataType="INT" Value="0" />
          </StructureMember>
        </Structure></Data>
      </Tag>
      <Tag Name="RecordWriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="RecordSource" RemoteElement="RecordEcho" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendText" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="TextSource" DataType="STRING" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="String" Length="5"><![CDATA['READY']]></Data>
      </Tag>
      <Tag Name="TextEcho" DataType="STRING" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="String" Length="0"><![CDATA['']]></Data>
      </Tag>
      <Tag Name="TextWriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="TextSource" RemoteElement="TextEcho" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="SendMembers" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="MemberWriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="RecordSource.Quality.Value" RemoteElement="RecordEcho.Quality.Value" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="Main" Disabled="false" Class="Standard">
        <Tags>
          <Tag Name="Samples" DataType="REAL" TagType="Base" Dimensions="3" ExternalAccess="Read Only">
            <Data Format="Decorated"><Array DataType="REAL" Dimensions="3">
              <Element Index="[0]" Value="100.0" /><Element Index="[1]" Value="2.5" /><Element Index="[2]" Value="-7.25" />
            </Array></Data>
          </Tag>
          <Tag Name="WideTarget" DataType="LINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="LINT" Value="-1" /></Data></Tag>
          <Tag Name="Grid" DataType="DINT" TagType="Base" Dimensions="2,3" ExternalAccess="Read Only">
            <Data Format="Decorated"><Array DataType="DINT" Dimensions="2,3">
              <Element Index="[0,0]" Value="10" /><Element Index="[0,1]" Value="20" /><Element Index="[0,2]" Value="30" />
              <Element Index="[1,0]" Value="40" /><Element Index="[1,1]" Value="50" /><Element Index="[1,2]" Value="60" />
            </Array></Data>
          </Tag>
          <Tag Name="LocalInbox" DataType="DINT" TagType="Base" Usage="Local" Dimensions="2" ExternalAccess="None">
            <Data Format="Decorated"><Array DataType="DINT" Dimensions="2">
              <Element Index="[0]" Value="-1" /><Element Index="[1]" Value="-1" />
            </Array></Data>
          </Tag>
          <Tag Name="LocalOutbox" DataType="DINT" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Decorated"><DataValue DataType="DINT" Value="73" /></Data>
          </Tag>
          <Tag Name="LocalReadControl" DataType="MESSAGE" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="LocalInbox[1]" RemoteElement="VirtualValue" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
          </Tag>
          <Tag Name="LocalWriteControl" DataType="MESSAGE" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="LocalOutbox" RemoteElement="LocalEcho" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
          </Tag>
          <Tag Name="RecordInbox" DataType="MessageRecord" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Decorated"><Structure DataType="MessageRecord">
              <DataValueMember Name="Batch" DataType="DINT" Value="0" />
              <DataValueMember Name="Lot" DataType="LINT" Value="0" />
              <DataValueMember Name="Ready" DataType="BOOL" Value="0" />
              <ArrayMember Name="Samples" DataType="INT" Dimensions="2"><Element Index="[0]" Value="0" /><Element Index="[1]" Value="0" /></ArrayMember>
              <StructureMember Name="Quality" DataType="MessageQuality">
                <DataValueMember Name="Value" DataType="REAL" Value="0.0" />
                <DataValueMember Name="Code" DataType="INT" Value="0" />
              </StructureMember>
            </Structure></Data>
          </Tag>
          <Tag Name="RecordReadControl" DataType="MESSAGE" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="RecordInbox" RemoteElement="RecordSource" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
          </Tag>
          <Tag Name="TextInbox" DataType="STRING" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="String" Length="0"><![CDATA['']]></Data>
          </Tag>
          <Tag Name="TextReadControl" DataType="MESSAGE" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="TextInbox" RemoteElement="TextSource" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
          </Tag>
          <Tag Name="MemberReadControl" DataType="MESSAGE" TagType="Base" Usage="Local" ExternalAccess="None">
            <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="RecordInbox.Samples[*]" RemoteElement="RecordSource.Samples[*]" RequestedLength="2" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
          </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(UseAlternateRead)MOV('AlternateValue',ReadControl.RemoteElement);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(SendRead)MSG(ReadControl);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(CancelRead)OTL(ReadControl.FLAGS.8);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(SendWrite)MSG(WriteControl);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(SetReadIndices)MOV(ReadLocalIndex,RealReadControl.LocalIndex)MOV(ReadRemoteIndex,RealReadControl.RemoteIndex);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(SendTyped)MSG(RealReadControl);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(SendTyped)MSG(WideWriteControl);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(ApplyReadTimeout)SSV(Message,ReadControl,UnconnectedTimeout,ReadTimeoutUs)GSV(Message,ReadControl,UnconnectedTimeout,ReadTimeoutEcho);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(SendIdentityRead)MSG(IdentityControl);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(SendIdentityAll)MSG(IdentityAllControl);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(ApplyIdentityAttribute)MOV(IdentityAttribute,IdentityControl.Attribute);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(SendGridRead)MSG(GridReadControl);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(CaptureReadFlags)MOV(ReadControl.FLAGS,ReadFlagsSnapshot);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(SendLocalMessages)MSG(LocalReadControl);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(SendLocalMessages)MSG(LocalWriteControl);</Text></Rung>
              <Rung Number="15" Type="N"><Text>XIC(SendRecord)MSG(RecordReadControl);</Text></Rung>
              <Rung Number="16" Type="N"><Text>XIC(SendRecord)MSG(RecordWriteControl);</Text></Rung>
              <Rung Number="17" Type="N"><Text>XIC(SendText)MSG(TextReadControl);</Text></Rung>
              <Rung Number="18" Type="N"><Text>XIC(SendText)MSG(TextWriteControl);</Text></Rung>
              <Rung Number="19" Type="N"><Text>XIC(SendMembers)MSG(MemberReadControl);</Text></Rung>
              <Rung Number="20" Type="N"><Text>XIC(SendMembers)MSG(MemberWriteControl);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms><ScheduledProgram Name="MainProgram" /></ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
