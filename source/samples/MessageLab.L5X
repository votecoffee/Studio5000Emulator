<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="MessageLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="MessageLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <Description>LogixLab sample for unconnected THIS data-table messaging and typed spans.</Description>
    <DataTypes>
      <DataType Name="MessageQuality" Family="NoFamily" Class="User">
        <Members>
          <Member Name="Value" DataType="REAL" Dimension="0" />
          <Member Name="Code" DataType="INT" Dimension="0" />
        </Members>
      </DataType>
      <DataType Name="MessageRecord" Family="NoFamily" Class="User">
        <Members>
          <Member Name="Batch" DataType="DINT" Dimension="0" />
          <Member Name="Lot" DataType="LINT" Dimension="0" />
          <Member Name="PackedFlags" DataType="SINT" Dimension="0" Hidden="true" ExternalAccess="None" />
          <Member Name="Ready" DataType="BIT" Dimension="0" Target="PackedFlags" BitNumber="0" />
          <Member Name="Samples" DataType="INT" Dimension="2" />
          <Member Name="Quality" DataType="MessageQuality" Dimension="0" />
        </Members>
      </DataType>
    </DataTypes>
    <Modules>
      <Module Name="Local" CatalogNumber="1756-L85E" Vendor="1" ProductType="14" ProductCode="168" Major="35" Minor="11" ParentModule="Local" ParentModPortId="1">
        <Ports><Port Id="1" Address="0" Type="ICP" Upstream="false"><Bus Size="17" /></Port></Ports>
      </Module>
    </Modules>
    <AddOnInstructionDefinitions />
    <Tags>
