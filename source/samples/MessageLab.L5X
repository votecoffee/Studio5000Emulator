<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="MessageLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="MessageLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <Description>LogixLab sample for unconnected THIS data-table messaging and typed spans.</Description>
    <DataTypes />
    <Modules>
      <Module Name="Local" CatalogNumber="1756-L85E" Vendor="1" ProductType="14" ProductCode="168" Major="35" Minor="11" ParentModule="Local" ParentModPortId="1">
        <Ports><Port Id="1" Address="0" Type="ICP" Upstream="false"><Bus Size="17" /></Port></Ports>
      </Module>
    </Modules>
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="UseAlternateRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SendRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SendWrite" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SendTyped" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="SetReadIndices" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadLocalIndex" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="ReadRemoteIndex" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="1" /></Data></Tag>
      <Tag Name="CancelRead" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadValue" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="0" /></Data></Tag>
      <Tag Name="WriteValue" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="42" /></Data></Tag>
      <Tag Name="VirtualValue" DataType="DINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="DINT" Value="17" /></Data></Tag>
      <Tag Name="AlternateValue" DataType="DINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="DINT" Value="64" /></Data></Tag>
      <Tag Name="ReadControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="ReadValue" RemoteElement="VirtualValue" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="WriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="WriteValue" RemoteElement="VirtualValue" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="RealReadback" DataType="REAL" TagType="Base" Dimensions="3">
        <Data Format="Decorated"><Array DataType="REAL" Dimensions="3">
          <Element Index="[0]" Value="0.0" /><Element Index="[1]" Value="0.0" /><Element Index="[2]" Value="0.0" />
        </Array></Data>
      </Tag>
      <Tag Name="WideSource" DataType="LINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="LINT" Value="9007199254740993" /></Data></Tag>
      <Tag Name="RealReadControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Read" LocalElement="RealReadback[*]" LocalIndex="0" RemoteElement="Program:MainProgram.Samples[*]" RemoteIndex="1" RequestedLength="2" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
      <Tag Name="WideWriteControl" DataType="MESSAGE" TagType="Base" ExternalAccess="None">
        <Data Format="Message"><MessageParameters MessageType="CIP Data Table Write" LocalElement="WideSource" RemoteElement="Program:MainProgram.WideTarget" RequestedLength="1" ConnectedFlag="0" ConnectionPath="THIS" CommTypeCode="0" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="Main" Disabled="false" Class="Standard">
        <Tags>
          <Tag Name="Samples" DataType="REAL" TagType="Base" Dimensions="3" ExternalAccess="Read Only">
            <Data Format="Decorated"><Array DataType="REAL" Dimensions="3">
              <Element Index="[0]" Value="100.0" /><Element Index="[1]" Value="2.5" /><Element Index="[2]" Value="-7.25" />
            </Array></Data>
          </Tag>
          <Tag Name="WideTarget" DataType="LINT" TagType="Base" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="LINT" Value="-1" /></Data></Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(UseAlternateRead)MOV('AlternateValue',ReadControl.RemoteElement);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(SendRead)MSG(ReadControl);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(CancelRead)OTL(ReadControl.TO);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(SendWrite)MSG(WriteControl);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(SetReadIndices)MOV(ReadLocalIndex,RealReadControl.LocalIndex)MOV(ReadRemoteIndex,RealReadControl.RemoteIndex);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(SendTyped)MSG(RealReadControl);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(SendTyped)MSG(WideWriteControl);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms><ScheduledProgram Name="MainProgram" /></ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
