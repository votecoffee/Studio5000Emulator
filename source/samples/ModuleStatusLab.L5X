<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="ModuleStatusLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="ModuleStatusLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <Description>LogixLab sample for Module Mode writes and status reads.</Description>
    <DataTypes />
    <Modules>
      <Module Name="Local" CatalogNumber="1756-L85E" Vendor="1" ProductType="14" ProductCode="168" Major="35" Minor="11" ParentModule="Local" ParentModPortId="1" Inhibited="false" MajorFault="true">
        <Ports>
          <Port Id="1" Address="0" Type="ICP" Upstream="false"><Bus Size="17" /></Port>
          <Port Id="2" Type="Ethernet" Upstream="false"><Bus /></Port>
        </Ports>
      </Module>
      <Module Name="RackOutput" CatalogNumber="1756-OB16D" Vendor="1" ProductType="7" ProductCode="4" Major="3" Minor="1" ParentModule="Local" ParentModPortId="1" Inhibited="true" MajorFault="true">
        <Ports><Port Id="1" Address="2" Type="ICP" Upstream="true" /></Ports>
      </Module>
      <Module Name="PointAdapter" CatalogNumber="1734-AENTR" Vendor="1" ProductType="12" ParentModule="Local" ParentModPortId="2" Inhibited="false" MajorFault="false">
        <Ports><Port Id="1" Address="192.0.2.42" Type="Ethernet" Upstream="true" /></Ports>
      </Module>
      <Module Name="RemoteRack" CatalogNumber="1756-EN2TR" Vendor="1" ProductType="12" ParentModule="Local" ParentModPortId="2" Inhibited="true" MajorFault="false">
        <Ports>
          <Port Id="1" Address="0" Type="ICP" Upstream="false"><Bus Size="7" /></Port>
          <Port Id="2" Address="192.0.2.7" Type="Ethernet" Upstream="true" />
        </Ports>
      </Module>
      <Module Name="RemoteInput" CatalogNumber="1756-IB16" Vendor="1" ProductType="7" ParentModule="RemoteRack" ParentModPortId="1" Inhibited="false" MajorFault="false">
        <Ports><Port Id="1" Address="4" Type="ICP" Upstream="true" /></Ports>
      </Module>
    </Modules>
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="ApplyMode" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ApplyModeST" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ModeCommand" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="5" /></Data></Tag>
      <Tag Name="ReadModule" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="StateWord" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="ModeWord" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="305463295" /></Data></Tag>
      <Tag Name="StMode" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="PathBytes" DataType="SINT" TagType="Base" Dimensions="6">
        <Data Format="Decorated"><Array DataType="SINT" Dimensions="6">
          <Element Index="[0]" Value="-99" /><Element Index="[1]" Value="-7" /><Element Index="[2]" Value="-7" />
          <Element Index="[3]" Value="-7" /><Element Index="[4]" Value="-7" /><Element Index="[5]" Value="99" />
        </Array></Data>
      </Tag>
      <Tag Name="EthernetPath" DataType="SINT" TagType="Base" Dimensions="16">
        <Data Format="Decorated"><Array DataType="SINT" Dimensions="16">
          <Element Index="[0]" Value="-99" /><Element Index="[15]" Value="99" />
        </Array></Data>
      </Tag>
      <Tag Name="RemotePath" DataType="SINT" TagType="Base" Dimensions="18">
        <Data Format="Decorated"><Array DataType="SINT" Dimensions="18">
          <Element Index="[0]" Value="-99" /><Element Index="[17]" Value="99" />
        </Array></Data>
      </Tag>
      <Tag Name="ApplyRackMode" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="RackModeCommand" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="4" /></Data></Tag>
      <Tag Name="RackMode" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="RemoteStatus" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="RemoteWaiting" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="ReadConnection" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="PointStatus" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="PointFaultCode" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="PointFaultInfo" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="-1" /></Data></Tag>
      <Tag Name="ModuleInhibited" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="Main" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ApplyMode)SSV(Module,RackOutput,Mode,ModeCommand);</Text></Rung>
              <Rung Number="1" Type="N"><Text>JSR(ReadModeST,0);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadModule)GSV(Module,RackOutput,Mode,ModeWord);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadModule)XIC(ModeWord.2)GSV(Module,RackOutput,EntryStatus,StateWord);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ReadModule)XIC(ModeWord.2)MEQ(StateWord,16#F000,16#6000)OTE(ModuleInhibited);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadModule)GSV(Module,RackOutput,Path,PathBytes[1]);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(ReadModule)GSV(Module,PointAdapter,Path,EthernetPath[1]);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(ReadModule)GSV(Module,RemoteInput,Path,RemotePath[1]);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(ApplyRackMode)SSV(Module,RemoteRack,Mode,RackModeCommand);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(ReadModule)GSV(Module,RemoteRack,Mode,RackMode);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(ReadModule)XIC(RackMode.2)GSV(Module,RemoteInput,EntryStatus,RemoteStatus);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(ReadModule)XIC(RackMode.2)MEQ(RemoteStatus,16#F000,16#7000)OTE(RemoteWaiting);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(ReadConnection)GSV(Module,PointAdapter,EntryStatus,PointStatus);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(ReadConnection)GSV(Module,PointAdapter,FaultCode,PointFaultCode);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(ReadConnection)GSV(Module,PointAdapter,FaultInfo,PointFaultInfo);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadModeST" Type="ST">
            <STContent>
              <Line Number="0">IF ApplyModeST THEN SSV(Module,RackOutput,Mode,ModeCommand); END_IF;</Line>
              <Line Number="1">IF ReadModule THEN GSV(Module,RackOutput,Mode,StMode); END_IF;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms><ScheduledProgram Name="MainProgram" /></ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
