<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="ModuleStatusLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="ModuleStatusLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <Description>LogixLab sample for read-only Module GSV from explicit source settings.</Description>
    <DataTypes />
    <Modules>
      <Module Name="Local" CatalogNumber="1756-L85E" Vendor="1" ProductType="14" ProductCode="168" Major="35" Minor="11" ParentModule="Local" ParentModPortId="1" Inhibited="false" MajorFault="true">
        <Ports><Port Id="1" Address="0" Type="ICP" Upstream="false"><Bus Size="17" /></Port></Ports>
      </Module>
      <Module Name="RackOutput" CatalogNumber="1756-OB16D" Vendor="1" ProductType="7" ProductCode="4" Major="3" Minor="1" ParentModule="Local" ParentModPortId="1" Inhibited="true" MajorFault="true">
        <Ports><Port Id="1" Address="2" Type="ICP" Upstream="true" /></Ports>
      </Module>
    </Modules>
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="ReadModule" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
      <Tag Name="StateWord" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="ModeWord" DataType="DINT" TagType="Base"><Data Format="Decorated"><DataValue DataType="DINT" Value="305463295" /></Data></Tag>
      <Tag Name="StMode" DataType="INT" TagType="Base"><Data Format="Decorated"><DataValue DataType="INT" Value="-1" /></Data></Tag>
      <Tag Name="ModuleInhibited" DataType="BOOL" TagType="Base"><Data Format="Decorated"><DataValue DataType="BOOL" Value="0" /></Data></Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="Main" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadModule)GSV(Module,RackOutput,EntryStatus,StateWord);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadModule)GSV(Module,RackOutput,Mode,ModeWord);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadModule)MEQ(StateWord,16#F000,16#6000)OTE(ModuleInhibited);</Text></Rung>
              <Rung Number="3" Type="N"><Text>JSR(ReadModeST,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadModeST" Type="ST">
            <STContent>
              <Line Number="0">IF ReadModule THEN GSV(Module,RackOutput,Mode,StMode); END_IF;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms><ScheduledProgram Name="MainProgram" /></ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
