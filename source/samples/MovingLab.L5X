<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="MovingLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="MovingLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Input" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="TakeSample" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="1" />
        </Data>
      </Tag>
      <Tag Name="ResetStatistics" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="InputFault" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Window" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="3" />
        </Data>
      </Tag>
      <Tag Name="Weighted" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallStatistics" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="1" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Average" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="Deviation" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="PopulationMean" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="InstructionFault" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="LengthInvalid" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="MeanState" DataType="MOVING_AVERAGE" TagType="Base">
        <Data Format="Decorated">
          <Structure DataType="MOVING_AVERAGE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In" DataType="REAL" Value="0.0" />
            <DataValueMember Name="InFault" DataType="BOOL" Value="0" />
            <DataValueMember Name="Initialize" DataType="BOOL" Value="0" />
            <DataValueMember Name="SampleEnable" DataType="BOOL" Value="1" />
            <DataValueMember Name="NumberOfSamples" DataType="DINT" Value="3" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
            <DataValueMember Name="UseWeights" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="DeviationState" DataType="MOVING_STD_DEV" TagType="Base">
        <Data Format="Decorated">
          <Structure DataType="MOVING_STD_DEV">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In" DataType="REAL" Value="0.0" />
            <DataValueMember Name="InFault" DataType="BOOL" Value="0" />
            <DataValueMember Name="Initialize" DataType="BOOL" Value="0" />
            <DataValueMember Name="SampleEnable" DataType="BOOL" Value="1" />
            <DataValueMember Name="NumberOfSamples" DataType="DINT" Value="3" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
            <DataValueMember Name="Average" DataType="REAL" Value="0.0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="MeanSamples" TagType="Base" DataType="REAL" Dimensions="4">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="4" Radix="Float">
            <Element Index="[0]" Value="0.0" />
            <Element Index="[1]" Value="0.0" />
            <Element Index="[2]" Value="0.0" />
            <Element Index="[3]" Value="0.0" />
          </Array>
        </Data>
      </Tag>
      <Tag Name="DeviationSamples" TagType="Base" DataType="REAL" Dimensions="4">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="4" Radix="Float">
            <Element Index="[0]" Value="0.0" />
            <Element Index="[1]" Value="0.0" />
            <Element Index="[2]" Value="0.0" />
            <Element Index="[3]" Value="0.0" />
          </Array>
        </Data>
      </Tag>
      <Tag Name="Weights" TagType="Base" DataType="REAL" Dimensions="4">
        <Data Format="Decorated">
          <Array DataType="REAL" Dimensions="4" Radix="Float">
            <Element Index="[0]" Value="0.5" />
            <Element Index="[1]" Value="0.25" />
            <Element Index="[2]" Value="0.125" />
            <Element Index="[3]" Value="0.0625" />
          </Array>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF CallStatistics THEN</Line>
              <Line Number="1">MeanState.In := Input;</Line>
              <Line Number="2">DeviationState.In := Input;</Line>
              <Line Number="3">MeanState.InFault := InputFault;</Line>
              <Line Number="4">DeviationState.InFault := InputFault;</Line>
              <Line Number="5">MeanState.Initialize := ResetStatistics;</Line>
              <Line Number="6">DeviationState.Initialize := ResetStatistics;</Line>
              <Line Number="7">MeanState.SampleEnable := TakeSample;</Line>
              <Line Number="8">DeviationState.SampleEnable := TakeSample;</Line>
              <Line Number="9">MeanState.NumberOfSamples := Window;</Line>
              <Line Number="10">DeviationState.NumberOfSamples := Window;</Line>
              <Line Number="11">MeanState.UseWeights := Weighted;</Line>
              <Line Number="12">MAVE(MeanState,MeanSamples,Weights);</Line>
              <Line Number="13">MSTD(DeviationState,DeviationSamples);</Line>
              <Line Number="14">CallCount := CallCount + 1;</Line>
              <Line Number="15">END_IF;</Line>
              <Line Number="16">Average := MeanState.Out;</Line>
              <Line Number="17">Deviation := DeviationState.Out;</Line>
              <Line Number="18">PopulationMean := DeviationState.Average;</Line>
              <Line Number="19">InstructionFault := MeanState.InstructFault OR DeviationState.InstructFault;</Line>
              <Line Number="20">LengthInvalid := MeanState.NumberOfSampInv OR DeviationState.NumberOfSampInv;</Line>
              <Line Number="21">GuardResult := 1 / FaultDivisor;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
