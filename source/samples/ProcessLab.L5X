<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="ProcessLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="ProcessLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
