    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(Steps,1,Steps);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Load)FFL(Incoming,Buffer[StartIndex],QueueControl,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Unload)FFU(Buffer[StartIndex],Outgoing,QueueControl,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Push)LFL(Incoming,StackStart,StackControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Pop)LFU(StackStart,Popped,StackControl,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ShiftLeft)BSL(BitStart,LeftControl,BitIn,?);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ShiftRight)BSR(Bits[BitIndex],RightControl,BitIn,?);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
