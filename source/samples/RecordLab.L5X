            <DataValueMember Name="POS" DataType="DINT" Value="0" />
            <DataValueMember Name="EN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EU" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EM" DataType="BOOL" Value="0" />
            <DataValueMember Name="ER" DataType="BOOL" Value="0" />
            <DataValueMember Name="UL" DataType="BOOL" Value="0" />
            <DataValueMember Name="IN" DataType="BOOL" Value="0" />
            <DataValueMember Name="FD" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="StackControl" TagType="Base" DataType="CONTROL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="CONTROL">
            <DataValueMember Name="LEN" DataType="DINT" Value="3" />
            <DataValueMember Name="POS" DataType="DINT" Value="0" />
            <DataValueMember Name="EN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EU" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EM" DataType="BOOL" Value="0" />
            <DataValueMember Name="ER" DataType="BOOL" Value="0" />
            <DataValueMember Name="UL" DataType="BOOL" Value="0" />
            <DataValueMember Name="IN" DataType="BOOL" Value="0" />
            <DataValueMember Name="FD" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="TextControl" TagType="Base" DataType="CONTROL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="CONTROL">
            <DataValueMember Name="LEN" DataType="DINT" Value="3" />
            <DataValueMember Name="POS" DataType="DINT" Value="0" />
            <DataValueMember Name="EN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EU" DataType="BOOL" Value="0" />
            <DataValueMember Name="DN" DataType="BOOL" Value="0" />
            <DataValueMember Name="EM" DataType="BOOL" Value="0" />
            <DataValueMember Name="ER" DataType="BOOL" Value="0" />
            <DataValueMember Name="UL" DataType="BOOL" Value="0" />
            <DataValueMember Name="IN" DataType="BOOL" Value="0" />
            <DataValueMember Name="FD" DataType="BOOL" Value="0" />
          </Structure>
        </Data>
      </Tag>
      <Tag Name="LoadPart" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="UnloadPart" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="PushPart" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="PopPart" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="LoadText" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="UnloadText" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(LoadPart)FFL(IncomingPart,PartQueue[0],PartControl,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(UnloadPart)FFU(PartQueue[0],OutgoingPart,PartControl,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(PushPart)LFL(IncomingPart,PartStack[0],StackControl,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(PopPart)LFU(PartStack[0],PoppedPart,StackControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(LoadText)FFL(IncomingText,TextQueue[0],TextControl,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(UnloadText)FFU(TextQueue[0],OutgoingText,TextControl,?,?);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
