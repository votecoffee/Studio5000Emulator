    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>JSR(BasicRecordQueues,0)XIC(LoadPart)FFL(IncomingPart,PartQueue[0],PartControl,?,?);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(UnloadPart)FFU(PartQueue[0],OutgoingPart,PartControl,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(PushPart)LFL(IncomingPart,PartStack[0],StackControl,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(PopPart)LFU(PartStack[0],PoppedPart,StackControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(LoadText)FFL(IncomingText,TextQueue[0],TextControl,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(UnloadText)FFU(TextQueue[0],OutgoingText,TextControl,?,?);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>DIV(1,FaultDivisor,GuardResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="BasicRecordQueues" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(SnapshotLoad)FFL(SnapshotTimerSource,SnapshotTimers[SnapshotIndex],SnapshotTimerQueue,?,?);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(SnapshotUnload)FFU(SnapshotTimers[SnapshotIndex],SnapshotTimerOut,SnapshotTimerQueue,?,?);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(SnapshotLoad)LFL(SnapshotCounterSource,SnapshotCounters[SnapshotIndex],SnapshotCounterStack,?,?);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(SnapshotUnload)LFU(SnapshotCounters[SnapshotIndex],SnapshotCounterOut,SnapshotCounterStack,?,?);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(SnapshotLoad)FFL(SnapshotControlSource,SnapshotControls[SnapshotIndex],SnapshotControlQueue,?,?);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(SnapshotUnload)FFU(SnapshotControls[SnapshotIndex],SnapshotControlOut,SnapshotControlQueue,?,?);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(SnapshotLoad)FFL(SnapshotRecordSource,SnapshotRecords[SnapshotIndex],SnapshotRecordQueue,?,?);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(SnapshotUnload)FFU(SnapshotRecords[SnapshotIndex],SnapshotRecordOut,SnapshotRecordQueue,?,?);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
