<?xml version='1.0' encoding='utf-8'?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.01" TargetName="ScaleLab" TargetType="Controller" ContainsContext="false">
  <Controller Name="ScaleLab" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="RawValue" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="RawMinimum" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="RawMaximum" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="4095.0" />
        </Data>
      </Tag>
      <Tag Name="EUMinimum" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="EUMaximum" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="100.0" />
        </Data>
      </Tag>
      <Tag Name="LimitOutput" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallScale" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="1" />
        </Data>
      </Tag>
      <Tag Name="FaultDivisor" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="1" />
        </Data>
      </Tag>
      <Tag Name="GuardResult" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="CallCount" DataType="DINT" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ScaledValue" DataType="REAL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="HighAlarm" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="LowAlarm" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ScaleFault" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="InvalidRange" DataType="BOOL" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Value="0" />
        </Data>
      </Tag>
      <Tag Name="ScaleState" DataType="SCALE" TagType="Base" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <Structure DataType="SCALE">
            <DataValueMember Name="EnableIn" DataType="BOOL" Value="1" />
            <DataValueMember Name="In" DataType="REAL" Value="0.0" />
            <DataValueMember Name="InRawMax" DataType="REAL" Value="4095.0" />
            <DataValueMember Name="InRawMin" DataType="REAL" Value="0.0" />
            <DataValueMember Name="InEUMax" DataType="REAL" Value="100.0" />
            <DataValueMember Name="InEUMin" DataType="REAL" Value="0.0" />
            <DataValueMember Name="Limiting" DataType="BOOL" Value="0" />
            <DataValueMember Name="EnableOut" DataType="BOOL" Value="0" />
            <DataValueMember Name="Out" DataType="REAL" Value="0.0" />
            <DataValueMember Name="MaxAlarm" DataType="BOOL" Value="0" />
            <DataValueMember Name="MinAlarm" DataType="BOOL" Value="0" />
            <DataValueMember Name="Status" DataType="DINT" Value="0" />
          </Structure>
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <Line Number="0">IF CallScale THEN</Line>
              <Line Number="1">    ScaleState.In := RawValue;</Line>
              <Line Number="2">    ScaleState.InRawMin := RawMinimum;</Line>
              <Line Number="3">    ScaleState.InRawMax := RawMaximum;</Line>
              <Line Number="4">    ScaleState.InEUMin := EUMinimum;</Line>
              <Line Number="5">    ScaleState.InEUMax := EUMaximum;</Line>
              <Line Number="6">    ScaleState.Limiting := LimitOutput;</Line>
              <Line Number="7">    SCL(ScaleState);</Line>
              <Line Number="8">    CallCount := CallCount + 1;</Line>
              <Line Number="9">END_IF;</Line>
              <Line Number="10">ScaledValue := ScaleState.Out;</Line>
              <Line Number="11">HighAlarm := ScaleState.MaxAlarm;</Line>
              <Line Number="12">LowAlarm := ScaleState.MinAlarm;</Line>
              <Line Number="13">ScaleFault := ScaleState.InstructFault;</Line>
              <Line Number="14">InvalidRange := ScaleState.InRawRangeInv;</Line>
              <Line Number="15">GuardResult := 1 / FaultDivisor;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
