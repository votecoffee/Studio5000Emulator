    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Reset)RES(StackControl)RES(SequenceControl)RES(TeachControl);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Push)LFL(StackValue,Stack[0],StackControl,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Pop)LFU(Stack[0],Popped,StackControl,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Advance)SQO(Patterns[0],Mask,Outputs,SequenceControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>SQI(Patterns[0],Mask,Feedback,SequenceControl,?,?)OTE(Matches);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(Teach)SQL(Learned[0],TeachValue,TeachControl,?,?);</Text>
              </Rung>
              <Rung Number="6" Type="N"><Text>JSR(IndirectOperands,0);</Text></Rung>
              <Rung Number="7" Type="N"><Text>JSR(NarrowSources,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="IndirectOperands" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(IndexedAdvance)SQO(IndexedPatterns[0],Masks[MaskIndex],IndexedOutputs[OutputIndex],IndexedSequenceControl,?,?);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(IndexedCompare)SQI(IndexedPatterns[0],Masks[MaskIndex],FeedbackInputs[SourceIndex],IndexedSequenceControl,?,?)OTE(IndexedMatches);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(IndexedTeach)SQL(IndexedLearned[0],TeachInputs[SourceIndex],IndexedTeachControl,?,?);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="NarrowSources" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(NarrowEnabled)SQL(NarrowByteTable[0],NarrowByteSources[NarrowIndex],NarrowByteControl,?,?);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(NarrowEnabled)SQL(NarrowWordTable[0],NarrowWordSources[NarrowIndex],NarrowWordControl,?,?);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(NarrowEnabled)SQL(NarrowPatterns[0],16#FFFF_FFFF,NarrowPatternControl,?,?);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(NarrowEnabled)SQI(NarrowByteTable[0],NarrowByteMask,NarrowByteSources[NarrowIndex],NarrowByteControl,?,?)OTE(NarrowByteMatch);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(NarrowEnabled)SQI(NarrowWordTable[0],NarrowWordMask,NarrowWordSources[NarrowIndex],NarrowWordControl,?,?)OTE(NarrowWordMatch);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(NarrowEnabled)SQI(NarrowPatterns[0],16#FFFF_FFFF,16#FFFF_FFFF,NarrowPatternControl,?,?)OTE(NarrowPatternMatch);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(NarrowEnabled)SQO(NarrowByteTable[0],NarrowByteMask,NarrowByteOutput,NarrowByteControl,?,?);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(NarrowEnabled)SQO(NarrowWordTable[0],NarrowWordMask,NarrowWordOutput,NarrowWordControl,?,?);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(NarrowEnabled)DIV(1,NarrowLateDivisor,NarrowLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
