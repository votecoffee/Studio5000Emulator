    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Disabled="false" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Reset)RES(MeanControl)RES(DeviationControl)RES(ColumnControl)RES(RowControl)RES(SortControl)RES(TextSortControl)RES(SearchControl)RES(BatchControl)RES(TransformControl)RES(BatchTransformControl)RES(StepTransformControl)RES(StepSearchControl);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Calculate)AVE(Values[0],0,Average,MeanControl,?,?);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Calculate)STD(Values[0],0,Deviation,DeviationControl,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Calculate)AVE(Grid[0,1],0,ColumnMean,ColumnControl,?,?);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Calculate)AVE(Grid[1,0],1,RowMean,RowControl,?,?);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(MeanControl.DN)XIC(DeviationControl.DN)XIC(ColumnControl.DN)XIC(RowControl.DN)OTE(Ready);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(Sort)SRT(SortValues[0],0,SortControl,?,?);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(TextSort)JSR(SortText,0);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(Search)FSC(SearchControl,?,?,ALL,Values[SearchControl.POS]&gt;=SearchLimit);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(BatchSearch)FSC(BatchControl,?,?,2,Values[BatchControl.POS]&gt;=BatchLimit);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(Transform)FAL(TransformControl,?,?,ALL,MappedValues[TransformControl.POS],Values[TransformControl.POS]*Gain+Bias);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(BatchTransform)FAL(BatchTransformControl,?,?,2,BatchValues[BatchTransformControl.POS],Values[BatchTransformControl.POS]*Gain+Bias);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(StepTransform)FAL(StepTransformControl,?,?,INC,StepValues[StepTransformControl.POS],Values[StepTransformControl.POS]*Gain+Bias);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(StepSearch)FSC(StepSearchControl,?,?,INC,Values[StepSearchControl.POS]&gt;=SearchLimit);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="SortText" Type="ST">
            <STContent>
              <Line Number="0">SRT(SortGrid[0,1],0,TextSortControl);</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
