    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(Enable)FIND(SourceText,SearchText,Start,Location);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>FIND(SourceText,MissingText,1,MissingPos);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>INSERT(SourceText,Addition,10,RllEdited);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>DELETE(RllEdited,Qty,10,Cleaned);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>JSR(EditText,0);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>EQU(Location,10)EQU(StPosition,10)EQU(MissingPos,0)EQU(SourceText,Cleaned)OTE(AllOK);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(Convert)LOWER(CaseText,Lowered);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(Convert)UPPER(CaseText,Uppered);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(Convert)STOR(NumericText,ParsedReal);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(Convert)RTOS(RealSource,FormattedReal);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="EditText" Type="ST">
            <STContent>
              <Line Number="0">INSERT(SourceText,Addition,1,StEdited);</Line>
              <Line Number="1">DELETE(StEdited,Qty,1,StEdited);</Line>
              <Line Number="2">FIND(StEdited,SearchText,1,StPosition);</Line>
              <Line Number="3">IF Convert THEN</Line>
              <Line Number="4">LOWER(CaseText,StLowered);</Line>
              <Line Number="5">UPPER(CaseText,StUppered);</Line>
              <Line Number="6">STOR(NumericText,StParsedReal);</Line>
              <Line Number="7">RTOS(RealSource,StFormattedReal);</Line>
              <Line Number="8">END_IF;</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" Class="Standard" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
