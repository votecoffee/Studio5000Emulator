    <Programs>
      <Program Name="BackgroundProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(BackgroundCount,1,BackgroundCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(BackgroundFirst,1,BackgroundFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,Name,ControllerName);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,TimeSlice,CommTimeSlice);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,ShareUnusedTimeSlice,ShareUnused);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,BackgroundTask,Watchdog,BackgroundWatchdog);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Name,FastTaskName);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,SlowTask,Rate,SlowRate);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,SlowTask,Priority,SlowPriority);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,InhibitTask,FastInhibit);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,DisableUpdateOutputs,FastNoOutput);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(ReadConfig)JSR(ReadSettings,0);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(ControlTasks)SSV(Task,FastTask,InhibitTask,TaskInhibitCommand);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>GSV(Task,FastTask,InhibitTask,LiveFastInhibit);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(ControlTasks)DIV(1,ControlDivisor,ControlResult);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadSettings" Type="ST">
            <STContent>
              <Line Number="0">GSV(Task,SlowTask,Rate,StSlowRate);</Line>
              <Line Number="1">GSV(Controller,,TimeSlice,StCommTimeSlice);</Line>
              <Line Number="2">GSV(Task,FastTask,Name,StFastTaskName);</Line>
              <Line Number="3">IF StApplyInhibit THEN SSV(Task,SlowTask,InhibitTask,StTaskInhibitCommand); END_IF;</Line>
              <Line Number="4">GSV(Task,SlowTask,InhibitTask,StSlowInhibit);</Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="FastProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(FastCount,1,FastCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(FastFirst,1,FastFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>TON(FastTimer,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(FastTimer.DN)OTE(FastDone);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Rate,FastRate);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Watchdog,FastWatchdog);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Priority,FastPriority);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="SlowProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(SlowCount,1,SlowCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(SlowFirst,1,SlowFirst);</Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="BackgroundTask" Type="CONTINUOUS" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="BackgroundProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="FastTask" Type="PERIODIC" Class="Standard" Priority="2" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false" Rate="10">
        <ScheduledPrograms>
          <ScheduledProgram Name="FastProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="SlowTask" Type="PERIODIC" Class="Standard" Priority="5" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false" Rate="25">
        <ScheduledPrograms>
          <ScheduledProgram Name="SlowProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
