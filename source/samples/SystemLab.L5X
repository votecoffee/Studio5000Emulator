    <Programs>
      <Program Name="BackgroundProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(BackgroundCount,1,BackgroundCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(BackgroundFirst,1,BackgroundFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,Name,ControllerName);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,TimeSlice,CommTimeSlice);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(ReadConfig)GSV(Controller,,ShareUnusedTimeSlice,ShareUnused);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,BackgroundTask,Watchdog,BackgroundWatchdog);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Name,FastTaskName);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,SlowTask,Rate,SlowRate);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,SlowTask,Priority,SlowPriority);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,InhibitTask,FastInhibit);</Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,DisableUpdateOutputs,FastNoOutput);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(ReadConfig)JSR(ReadSettings,0);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(ControlTasks)SSV(Task,FastTask,InhibitTask,TaskInhibitCommand);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>GSV(Task,FastTask,InhibitTask,LiveFastInhibit);</Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(ControlTasks)DIV(1,ControlDivisor,ControlResult);</Text>
              </Rung>
              <Rung Number="15" Type="N"><Text>JSR(ReadClockValues,0);</Text></Rung>
              <Rung Number="16" Type="N"><Text>JSR(ReadCurrentInstances,0)JSR(ReadProgramTimes,0);</Text></Rung>
              <Rung Number="17" Type="N"><Text>JSR(ReadTaskTimes,0);</Text></Rung>
              <Rung Number="18" Type="N"><Text>JSR(ReadTaskStarts,0);</Text></Rung>
              <Rung Number="19" Type="N"><Text>XIC(ReadTypedTimes)JSR(ReadTypedClock,0);</Text></Rung>
              <Rung Number="20" Type="N"><Text>XIC(ApplyFastRate)SSV(Task,FastTask,Rate,FastRateCommandUs);</Text></Rung>
              <Rung Number="21" Type="N"><Text>GSV(Task,FastTask,Rate,LiveFastRateUs);</Text></Rung>
              <Rung Number="22" Type="N"><Text>XIC(ApplySlowPriority)SSV(Task,SlowTask,Priority,SlowPriorityCommand);</Text></Rung>
              <Rung Number="23" Type="N"><Text>GSV(Task,SlowTask,Priority,LiveSlowPriority);</Text></Rung>
              <Rung Number="24" Type="N"><Text>XIC(ApplyWatchdog)SSV(Task,THIS,Watchdog,WatchdogCommandUs);</Text></Rung>
              <Rung Number="25" Type="N"><Text>GSV(Task,THIS,Watchdog,LiveWatchdogUs);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadTypedClock" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>GSV(WallClockTime,,CurrentValue,ClockDate);</Text></Rung>
              <Rung Number="1" Type="N"><Text>MOV(ClockDate,ClockDateNs);</Text></Rung>
              <Rung Number="2" Type="N"><Text>GSV(Task,THIS,StartTime,TaskStartDate);</Text></Rung>
              <Rung Number="3" Type="N"><Text>GSV(Program,THIS,LastScanTime,ProgramTime32);</Text></Rung>
              <Rung Number="4" Type="N"><Text>GSV(Task,THIS,MaxScanTime,TaskTime32);</Text></Rung>
              <Rung Number="5" Type="N"><Text>GSV(Task,FastTask,MinimumInterval,TaskMinTime);</Text></Rung>
              <Rung Number="6" Type="N"><Text>GSV(Task,FastTask,MaximumInterval,TaskMaxTime);</Text></Rung>
              <Rung Number="7" Type="N"><Text>GSV(Task,FastTask,MinimumInterval,TaskMinTimeWords[1]);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadTaskStarts" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadTaskStarts)GSV(Task,THIS,StartTime,ThisTaskStart);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadTaskStarts)GSV(Task,FastTask,StartTime,TaskStartWords[TaskStartIndex]);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadTaskStarts)GSV(Task,FastTask,MinimumInterval,TaskMinWords[1]);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadTaskStarts)GSV(Task,FastTask,MaximumInterval,TaskMaxWords[1]);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ResetTaskIntervals)SSV(Task,FastTask,MinimumInterval,IntervalResetTime)GSV(Task,FastTask,MinimumInterval,FastMinAfterReset);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadTaskStarts)JSR(ReadTaskStartsST,0);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(ReadTaskStarts)DIV(1,TaskStartDivisor,TaskStartResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadTaskStartsST" Type="ST">
            <STContent>
              <Line Number="0">GSV(Task,THIS,StartTime,StTaskStart);</Line>
              <Line Number="1">GSV(Task,FastTask,MinimumInterval,StTaskMin[1]);</Line>
              <Line Number="2">GSV(Task,FastTask,MaximumInterval,StTaskMax[1]);</Line>
              <Line Number="3">GSV(Task,FastTask,MaximumInterval,TaskMaxTimeWords[1]);</Line>
              <Line Number="4">IF ResetTaskIntervals THEN SSV(Task,FastTask,MaximumInterval,IntervalResetWords[0]); GSV(Task,FastTask,MaximumInterval,FastMaxAfterReset); END_IF;</Line>
            </STContent>
          </Routine>
          <Routine Name="ReadSettings" Type="ST">
            <STContent>
              <Line Number="0">GSV(Task,SlowTask,Rate,StSlowRate);</Line>
              <Line Number="1">GSV(Controller,,TimeSlice,StCommTimeSlice);</Line>
              <Line Number="2">GSV(Task,FastTask,Name,StFastTaskName);</Line>
              <Line Number="3">IF StApplyInhibit THEN SSV(Task,SlowTask,InhibitTask,StTaskInhibitCommand); END_IF;</Line>
              <Line Number="4">GSV(Task,SlowTask,InhibitTask,StSlowInhibit);</Line>
              <Line Number="5">IF ReadClock THEN GSV(WallClockTime,,CurrentValue,StClockMicros); GSV(WallClockTime,,DateTime,StClockUtc[0]); END_IF;</Line>
              <Line Number="6">IF ReadTiming THEN GSV(Program,BackgroundProgram,LastScanTime,StProgramLast); GSV(Program,BackgroundProgram,MaxScanTime,StProgramMax); END_IF;</Line>
              <Line Number="7">IF ReadThis THEN GSV(Task,THIS,Name,StThisTaskName); GSV(Task,THIS,Watchdog,StThisWatchdog); GSV(Program,THIS,LastScanTime,StThisProgramLast); END_IF;</Line>
              <Line Number="8">IF ReadTaskTiming THEN GSV(Task,BackgroundTask,LastScanTime,StBackgroundTaskLast); GSV(Task,FastTask,LastScanTime,StFastTaskLast); GSV(Task,SlowTask,LastScanTime,StSlowTaskLast); END_IF;</Line>
              <Line Number="9">IF ResetScanMax THEN SSV(Task,FastTask,MaxScanTime,ResetTaskMaxValue); GSV(Task,FastTask,MaxScanTime,FastTaskMaxAfterReset); END_IF;</Line>
              <Line Number="10">IF ResetLastAndStart THEN SSV(Task,FastTask,LastScanTime,ScanTimeResetZero); SSV(Task,FastTask,StartTime,StartTimeResetZero); GSV(Task,FastTask,LastScanTime,FastTaskLastAfterReset); GSV(Task,FastTask,StartTime,FastTaskStartAfterReset); END_IF;</Line>
              <Line Number="11">IF ControlSlowProgram THEN SSV(Program,SlowProgram,DisableFlag,SlowProgramDisable); END_IF;</Line>
              <Line Number="12">GSV(Program,SlowProgram,DisableFlag,LiveSlowProgramDisabled);</Line>
              <Line Number="13">IF ReadObjectIdentity THEN GSV(Program,FastProgram,Name,StObjectProgramName); GSV(Routine,THIS,Name,StObjectRoutineName); GSV(Task,SlowTask,Instance,StObjectTaskSlot); END_IF;</Line>
              <Line Number="14">IF ReadControllerDevice THEN GSV(ControllerDevice,,Type,DeviceType); GSV(ControllerDevice,,Vendor,DeviceVendor); END_IF;</Line>
            </STContent>
          </Routine>
          <Routine Name="ReadClockValues" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadClock)GSV(WallClockTime,,CurrentValue,ClockMicros);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadClock)GSV(WallClockTime,,CurrentValue,ClockWords[1]);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadClock)GSV(WallClockTime,,DateTime,ClockUtc[ClockIndex]);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadClock)GSV(WallClockTime,,LocalDateTime,ClockLocal[1]);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadCurrentInstances" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadThis)GSV(Task,THIS,Name,ThisTaskName);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadThis)GSV(Task,THIS,Watchdog,ThisWatchdog);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadThis)GSV(Program,THIS,LastScanTime,ThisWords[ThisIndex]);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadThis)GSV(Program,THIS,MaxScanTime,ThisProgramMax);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ReadObjectIdentity)GSV(Program,THIS,Name,ObjectProgramName)GSV(Routine,THIS,Name,ObjectRoutineName)GSV(Task,THIS,Instance,ObjectTaskSlot);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadControllerDevice)GSV(ControllerDevice,,DeviceName,DeviceNameBytes)GSV(ControllerDevice,,ProductCode,DeviceProductCode)GSV(ControllerDevice,,ProductRev,DeviceProductRev);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadProgramTimes" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadTiming)GSV(Program,BackgroundProgram,LastScanTime,TimingWords[TimingIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadTiming)GSV(Program,BackgroundProgram,MaxScanTime,ProgramMax);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadTiming)GSV(Program,FastProgram,LastScanTime,FastLast);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadTiming)GSV(Program,FastProgram,MaxScanTime,FastMax);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ReadTiming)GSV(Program,SlowProgram,LastScanTime,SlowLast);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadTiming)GSV(Program,SlowProgram,MaxScanTime,SlowMax);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="ReadTaskTimes" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,BackgroundTask,LastScanTime,TaskWords[TaskTimingIndex]);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,BackgroundTask,MaxScanTime,BackgroundTaskMax);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,FastTask,LastScanTime,FastTaskLast);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,FastTask,MaxScanTime,FastTaskMax);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,SlowTask,LastScanTime,SlowTaskLast);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,SlowTask,MaxScanTime,SlowTaskMax);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,THIS,LastScanTime,ThisBackgroundTaskLast);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(ResetScanMax)SSV(Program,THIS,MaxScanTime,ResetProgramMaxValue)GSV(Program,THIS,MaxScanTime,ProgramMaxAfterReset);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(ResetLastAndStart)SSV(Program,THIS,LastScanTime,ScanTimeResetZero)GSV(Program,THIS,LastScanTime,ProgramLastAfterReset);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(ControlFastProgram)SSV(Program,FastProgram,DisableFlag,FastProgramDisable);</Text></Rung>
              <Rung Number="10" Type="N"><Text>GSV(Program,FastProgram,DisableFlag,LiveFastProgramDisabled);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(ActivateStandbyProgram)SSV(Program,StandbyProgram,DisableFlag,StandbyProgramDisable);</Text></Rung>
              <Rung Number="12" Type="N"><Text>GSV(Program,StandbyProgram,DisableFlag,StandbyProgramDisabled);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="FastProgram" MainRoutineName="Main" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(FastCount,1,FastCount);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(S:FS)ADD(FastFirst,1,FastFirst);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>TON(FastTimer,?,?);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(FastTimer.DN)OTE(FastDone);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Rate,FastRate);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Watchdog,FastWatchdog);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(ReadConfig)GSV(Task,FastTask,Priority,FastPriority);</Text>
              </Rung>
              <Rung Number="7" Type="N"><Text>XIC(ReadThis)GSV(Task,THIS,Rate,ThisFastRate);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(ReadThis)GSV(Task,THIS,Priority,ThisFastPriority);</Text>
              </Rung>
              <Rung Number="9" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,THIS,LastScanTime,ThisFastTaskLast);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="SlowProgram" MainRoutineName="Main" Class="Standard">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>XIC(ReadThis)GSV(Task,THIS,Rate,ThisSlowRate)GSV(Task,THIS,Priority,ThisSlowPriority);</Text></Rung>
              <Rung Number="1" Type="N"><Text>ADD(SlowCount,1,SlowCount);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(S:FS)ADD(SlowFirst,1,SlowFirst);</Text>
              </Rung>
              <Rung Number="3" Type="N"><Text>XIC(ReadTaskTiming)GSV(Task,THIS,LastScanTime,ThisSlowTaskLast);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="StandbyProgram" MainRoutineName="Main" Class="Standard" Disabled="true">
        <Tags />
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>ADD(StandbyCount,1,StandbyCount);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(S:FS)ADD(StandbyFirst,1,StandbyFirst);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="BackgroundTask" Type="CONTINUOUS" Class="Standard" Priority="10" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="BackgroundProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="FastTask" Type="PERIODIC" Class="Standard" Priority="2" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false" Rate="10">
        <ScheduledPrograms>
          <ScheduledProgram Name="FastProgram" />
        </ScheduledPrograms>
      </Task>
      <Task Name="SlowTask" Type="PERIODIC" Class="Standard" Priority="5" Watchdog="500" InhibitTask="false" DisableUpdateOutputs="false" Rate="25">
        <ScheduledPrograms>
          <ScheduledProgram Name="SlowProgram" />
          <ScheduledProgram Name="StandbyProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
