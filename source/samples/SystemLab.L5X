        </Data>
      </Tag>
      <Tag Name="ControlDivisor" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="1" />
        </Data>
      </Tag>
      <Tag Name="ControlResult" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
