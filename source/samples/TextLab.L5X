        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="AdjustOutput" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Step" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="2" />
        </Data>
      </Tag>
      <Tag Name="AOITotal" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Packed" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="0" />
