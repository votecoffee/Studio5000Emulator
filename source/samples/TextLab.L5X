      </Tag>
      <Tag Name="SearchIndex" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write">
        <Data Format="Decorated">
          <DataValue DataType="DINT" Radix="Decimal" Value="99" />
        </Data>
      </Tag>
