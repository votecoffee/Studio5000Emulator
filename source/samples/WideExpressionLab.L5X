              <Rung Number="6" Type="N"><Text>XIC(R64Enabled)CPT(R64UDINT,R64Source);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(R64Enabled)CPT(R64ULINT,R64Source);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(R64Enabled)CPT(R64REAL,R64Source);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(R64Enabled)CPT(R64LREAL,R64Source);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(R64Enabled)CPT(R64Selected[R64Index],R64Value);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(R64Enabled)XIC(R64IntegerFault)CPT(R64IntegerFaultResult,R64BadInteger);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(R64Enabled)XIC(R64RealFault)CPT(R64RealFaultResult,R64Big);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(R64Enabled)DIV(1,R64LateDivisor,R64LateResult);</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(R64Enabled)CMP((R64REAL=R64Source)&amp;&amp;(R64DINT&gt;R64Source))OTE(R64Converted);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="FloatingConstants" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitDefault,0.1);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitExplicit,0.1L);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitDelta,1.0000000000000002L-1.0);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitPower,FPLitInput**0.5);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitLarge,1e308L);</Text></Rung>
