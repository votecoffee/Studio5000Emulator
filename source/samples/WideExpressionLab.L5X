              <Rung Number="7" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitReal,1.0000000000000002L);</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(FPLitEnabled)CMP(0.1L&lt;&gt;0.1)OTE(FPLitDifferent);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitSelected[FPLitIndex],FPLitInputs[FPLitIndex]+0.5L);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(FPLitEnabled)XIC(FPLitDomainFault)CPT(FPLitDomainResult,LN(-1.0L));</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(FPLitEnabled)XIC(FPLitRangeFault)CPT(FPLitRangeResult,128.0L);</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(FPLitEnabled)DIV(1,FPLitLateDivisor,FPLitLateResult);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(FPLitEnabled)CPT(FPLitLower,.5l);</Text></Rung>
