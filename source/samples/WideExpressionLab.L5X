          </Routine>
          <Routine Name="FunctionRealExpressions" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealSin,SIN(FunctionRealAngle));</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealCos,COS(FunctionRealAngle));</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealTan,TAN(1UL));</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealLn,LN(1UL));</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealLog,LOG(10L));</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealDegrees,DEG(1U));</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealRadians,RAD(180U));</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealAsin,ASN(1UL));</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealAcos,ACS(0L));</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealAtan,ATN(1UL));</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealRootAlias,SQRT(9L));</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(FunctionRealEnabled)CPT(FunctionRealSelected[FunctionRealIndex],SIN(FunctionRealAngle));</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(FunctionRealEnabled)CMP(SIN(FunctionRealAngle)&gt;=0)OTE(FunctionRealMatch);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(FunctionRealEnabled)XIC(FunctionRealDomainEnabled)CPT(FunctionRealDomainResult,ASN(FunctionRealDomainSource));</Text></Rung>
              <Rung Number="14" Type="N"><Text>XIC(FunctionRealEnabled)DIV(1,FunctionRealLateDivisor,FunctionRealLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="StringNumericConditions" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(StringNumericEnabled)CMP((StringNumericWide+0.0=16777216U)&amp;&amp;(StringNumericCodes[StringNumericIndex]=StringNumericNeedle)&amp;&amp;!StringNumericInhibit)OTE(StringNumericRealMatch);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(StringNumericEnabled)CMP((StringNumericDouble&gt;1.0L)&amp;&amp;(StringNumericCodes[StringNumericIndex]=StringNumericNeedle)&amp;&amp;!StringNumericInhibit)OTE(StringNumericDoubleMatch);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(StringNumericEnabled)DIV(1,StringNumericLateDivisor,StringNumericLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="IntegerStringConditions" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(IntegerStringEnabled)CMP((IntegerStringSource&gt;IntegerStringThreshold)&amp;&amp;(StringNumericCodes[IntegerStringIndex]=StringNumericNeedle)&amp;&amp;!IntegerStringInhibit)OTE(IntegerStringMatch);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(IntegerStringEnabled)CMP((IntegerStringSource-1UL=IntegerStringThreshold)&amp;&amp;(StringNumericCodes[IntegerStringIndex]=StringNumericNeedle))OTE(IntegerStringExact);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(IntegerStringEnabled)CMP(((IntegerStringSource AND 16#1UL)=1UL)&amp;&amp;(StringNumericCodes[IntegerStringIndex]=StringNumericNeedle))OTE(IntegerStringPatternMatch);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(IntegerStringEnabled)CMP((IntegerStringSigned+IntegerStringSmall=9007199254740994L)&amp;&amp;(StringNumericCodes[IntegerStringIndex]=StringNumericNeedle))OTE(IntegerStringMixed);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(IntegerStringEnabled)DIV(1,IntegerStringLateDivisor,IntegerStringLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="TemporalConditions" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(TemporalEnabled)CMP((TemporalHighDuration&gt;TemporalDuration)&amp;&amp;!TemporalInhibit)OTE(TemporalDurationMatch);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(TemporalEnabled)CMP((TemporalHighStamp&gt;TemporalStamp)&amp;&amp;!TemporalInhibit)OTE(TemporalStampMatch);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(TemporalEnabled)CMP((TemporalHighDuration&gt;TemporalLimits[TemporalIndex])&amp;&amp;(TemporalHighStamp&gt;TemporalStamp)&amp;&amp;(StringNumericCodes[TemporalIndex]=StringNumericNeedle)&amp;&amp;!TemporalInhibit)OTE(TemporalCombined);</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(TemporalEnabled)DIV(1,TemporalLateDivisor,TemporalLateResult);</Text></Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="Continuous" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
