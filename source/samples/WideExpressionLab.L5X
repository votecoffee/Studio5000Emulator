              <Rung Number="1" Type="N"><Text>XIC(R64Enabled)CPT(R64INT,R64Source);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(R64Enabled)CPT(R64DINT,R64Source);</Text></Rung>
