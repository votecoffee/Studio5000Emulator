    <Programs>
      <Program Name="MainProgram" MainRoutineName="MainRoutine" Class="Standard" Disabled="false">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text>ADD(Scans,1,Scans);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text>XIC(Execute)CPT(SignedResult,SignedInput+SignedDelta);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text>XIC(Execute)CPT(UnsignedResult,UnsignedInput+UnsignedDelta);</Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text>XIC(Execute)CPT(SignedQuotient,SignedMinimum/Divisor);</Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text>XIC(Execute)CPT(SignedRemainder,SignedMinimum MOD Divisor);</Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text>XIC(Execute)CMP(SignedResult&gt;SignedInput)OTE(ExactCompare);</Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text>XIC(Execute)MEQ(Pattern,Mask,Expected)OTE(MaskMatches);</Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text>XIC(Execute)CPT(ByteResult,ByteInput+ByteDelta);</Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text>XIC(Execute)CPT(GuardResult,SignedResult/FaultDivisor);</Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text>XIC(ExecuteIndexed)CPT(ExpressionResults[ExpressionIndex],ExpressionValues[ExpressionIndex]+SignedDelta);</Text>
                <Comment>Indexed calculations stay disabled with index 99 and unknown arrays. Select index 0 and initialize both input elements before enabling ExecuteIndexed.</Comment>
              </Rung>
              <Rung Number="10" Type="N">
                <Text>XIC(ExecuteIndexed)CPT(ExpressionNarrowResults[ExpressionIndex],ExpressionNarrow[ExpressionIndex]+1);</Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text>XIC(ExecuteIndexed)CMP(ExpressionResults[ExpressionIndex]&gt;ExpressionValues[ExpressionIndex])OTE(ExpressionWideMatches);</Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text>XIC(ExecuteIndexed)CMP((ExpressionNarrowResults[ExpressionIndex]&gt;ExpressionNarrow[ExpressionIndex])&amp;&amp;Execute)OTE(ExpressionNarrowMatches);</Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionSum,SignedInput+ExpressionDelta);</Text>
                <Comment>Enable MixedExpressionMath for exact mixed integer arithmetic. Every arithmetic subtree contains an actual tag of its common type.</Comment>
              </Rung>
              <Rung Number="14" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionDifference,SignedInput-ExpressionDelta);</Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionProduct,SignedDelta*ExpressionSmall);</Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionQuotient,SignedMinimum/ExpressionDelta);</Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionRemainder,SignedMinimum MOD ExpressionDelta);</Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionUnsigned,UnsignedInput-ByteDelta);</Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionAbsolute,ABS(SignedDelta*ExpressionSmall));</Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Text>XIC(MixedExpressionMath)CMP((SignedInput+ExpressionDelta&gt;SignedInput)&amp;&amp;(ExpressionSmall&lt;SignedDelta))OTE(MixedExpressionMatches);</Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text>XIC(MixedExpressionMath)CPT(ExpressionNested,(SignedInput+ExpressionDelta)/SignedDelta);</Text>
              </Rung>
              <Rung Number="22" Type="N"><Text>JSR(Binary64,0);</Text></Rung>
              <Rung Number="23" Type="N"><Text>JSR(Binary64Results,0);</Text></Rung>
              <Rung Number="24" Type="N"><Text>JSR(FloatingConstants,0);</Text></Rung>
              <Rung Number="25" Type="N"><Text>JSR(IntegerConstants,0);</Text></Rung>
              <Rung Number="26" Type="N"><Text>JSR(DoubleIntegerConstants,0);</Text></Rung>
              <Rung Number="27" Type="N"><Text>JSR(IntegerFileConstants,0);</Text></Rung>
              <Rung Number="28" Type="N"><Text>JSR(NumericMoveConstants,0)JSR(RadixMoves,0)JSR(MathConstants,0)JSR(ComparisonConstants,0)JSR(RealIntegerConstants,0)JSR(IntegerOperandConstants,0)JSR(BitwiseOperandConstants,0)JSR(Binary64SourceResults,0)JSR(DintPatternConstants,0)JSR(DintWordExpressions,0)JSR(WideBcdExpressions,0)JSR(WideRootPowerExpressions,0)JSR(BinaryRadixExpressions,0)JSR(RadixMathBlocks,0)JSR(RadixComparisons,0)JSR(RealRadixBlocks,0)JSR(RealComparisonConstants,0)JSR(MixedRealExpressions,0)JSR(FunctionRealExpressions,0)JSR(StringNumericConditions,0)JSR(IntegerStringConditions,0)JSR(TemporalConditions,0);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Binary64" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N"><Text>XIC(F64Enabled)CPT(F64Results[F64Index],F64Inputs[F64Index]-1);</Text></Rung>
              <Rung Number="1" Type="N"><Text>XIC(F64Enabled)MOV(F64Results[F64Index],F64Precision);</Text></Rung>
              <Rung Number="2" Type="N"><Text>XIC(F64Enabled)CPT(F64Sum,(1/2)+(1/2));</Text></Rung>
              <Rung Number="3" Type="N"><Text>XIC(F64Enabled)CPT(F64Integral,F64Dint+1);</Text></Rung>
              <Rung Number="4" Type="N"><Text>XIC(F64Enabled)CPT(F64StoredReal,F64Real+1);</Text></Rung>
              <Rung Number="5" Type="N"><Text>XIC(F64Enabled)CPT(F64UnsignedResult,F64Unsigned);</Text></Rung>
              <Rung Number="6" Type="N"><Text>XIC(F64Enabled)CPT(F64SignedResult,F64Signed);</Text></Rung>
              <Rung Number="7" Type="N"><Text>XIC(F64Enabled)CPT(F64Root,SQR(F64Inputs[1])+SQR(F64Inputs[1]));</Text></Rung>
              <Rung Number="8" Type="N"><Text>XIC(F64Enabled)CPT(F64Power,F64Inputs[1]**F64Half);</Text></Rung>
              <Rung Number="9" Type="N"><Text>XIC(F64Enabled)CPT(F64Remainder,F64Inputs[2] MOD 3);</Text></Rung>
              <Rung Number="10" Type="N"><Text>XIC(F64Enabled)CMP((F64Inputs[0]&gt;1)&amp;&amp;(F64Integral&gt;F64StoredReal))OTE(F64Matches);</Text></Rung>
              <Rung Number="11" Type="N"><Text>XIC(F64Enabled)XIC(F64DomainFault)CPT(F64DomainResult,LN(F64Domain));</Text></Rung>
              <Rung Number="12" Type="N"><Text>XIC(F64Enabled)XIC(F64OverflowFault)CPT(F64OverflowResult,F64Big*2);</Text></Rung>
              <Rung Number="13" Type="N"><Text>XIC(F64Enabled)DIV(1,F64LateDivisor,F64LateResult);</Text></Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Binary64Results" Type="RLL">
